# Dependencies and build output
node_modules/
# Anchored: an unanchored `build/` would hide a packages/*/src/**/build/ source directory from oxlint
/dist/
/build/
/coverage/
/packages/*/dist/
/packages/*/build/
/packages/*/coverage/
.cache/
*.tsbuildinfo

# Environment (keep .env.example)
.env
.env.*
!.env.example

# Logs and OS cruft
*.log
.DS_Store
Thumbs.db

# Editors
.idea/
.vscode/*
!.vscode/extensions.json

# Claude Code: per-user settings and local worktrees
.claude/settings.local.json
.claude/worktrees/

# Upstream snapshot: fetched by `bun run upstream:sync`, never committed (FR-1)
/conformance/upstream/

# PHP fixture installs: `bun run php-fixtures:install`, never committed
/conformance/tests/xaravel/php-fixtures/*/vendor/

# BMAD: per-user install answers (team config lives in _bmad/config.toml and _bmad/custom/config.toml)
_bmad/config.user.toml
