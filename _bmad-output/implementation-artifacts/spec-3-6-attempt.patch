+const php = (namespace: string, body: string, uses: readonly string[] = []): string =>
+  `<?php\n\nnamespace ${namespace};\n\n${uses.map((use) => `use ${use};\n`).join("")}${uses.length > 0 ? "\n" : ""}${body}\n`;
