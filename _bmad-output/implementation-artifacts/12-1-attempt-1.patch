+// Laravel's `Illuminate\Support\Traits\Conditionable` (Story 12.1), as a runtime trait: `class X extends mixin(Base,
+// Conditionable)` (AD-26 Traits row).
+//
+// Logic. Ported one-for-one from Upstream. A `value` that is a function (not a class) is called with the instance and
+// replaced by its result, as Upstream calls a `Closure`. `arguments.length` stands in for `func_num_args()`: with no
+// argument the method returns a `HigherOrderWhenProxy` (`unless` negating the condition it captures), and with one it
+// returns the proxy holding that condition. Otherwise the value is tested with PHP truthiness (`toBool`), and the
+// callback's (or default's) result is returned, or the instance when that result is `null` (AD-9: `undefined` too).
+//
+// Dual helper (AD-6, DIV-1). `when` / `unless` return a Promise only when a callback returns a native Promise
+// (`instanceof Promise`): the `value` closure, `callback` or `default`. The Promise resolves to what the sync path
+// returns; a Promise condition is awaited, never tested for truthiness. A thenable that is not a Promise (a query
+// Builder) is an ordinary value, so `when(c, (q) => q.where(…))` stays sync. On the async path a thenable result is
+// adopted by the Promise, as every Promise adopts a thenable. The types are overloads: an async callback gives
+// `Promise<…>`, a sync one `R | this`; no signature declares `T | Promise<T>`.
+//
+// Named arguments (AD-26). `when` / `unless` have three optional parameters, so they also accept one options object,
+// `when({ value, callback, default })`. It is detected narrowly (`readOptions`): the only argument, a plain object that
+// is not a contract token, whose own keys are a non-empty subset of `value`, `callback` and `default` with at least one
+// of `callback` / `default`, each of which is a function or `null`. Any other object is a `value`. A PHP array condition
+// of exactly that shape is therefore read as options (conformance/escalations/ESC-12.1-3.md).
+import { Error as PhpError, isContractToken, registerClass, toBool } from "@xaravel/runtime";
+import type { NotPromise } from "@xaravel/contracts/async";
+import { HigherOrderWhenProxy } from "../HigherOrderWhenProxy";
+
+/** A condition: the value itself, or a closure the instance is passed to, whose result is the value. */
+type Value<S, V> = V | ((self: S) => V);
+/** A condition that settles later: a Promise, or a closure returning one. */
+type AsyncValue<S, V> = Promise<V> | ((self: S) => Promise<V>);
+/** A callback or default: called with the instance and the condition's value. */
+type Callback<S, V, R> = (self: S, value: V) => R;
+/** What a callback's result `r` makes the method return: `r ?? this`. */
+type Result<R, S> = Exclude<R, null | undefined | void> | S;
+/** The options form (AD-26) of `when` / `unless`, keyed by the camelCase PHP parameter names. */
+type ValueOptions<S, V, R, D> = { value?: Value<S, V>; callback?: Callback<S, V, R> | null; default?: Callback<S, V, D> | null };
+/** An options object whose `key` is given, as `T`. */
+type Given<K extends string, T> = { [P in K]: T };
+/** The options form with a condition that settles later. */
+type AsyncValueOptions<S, V, R, D> = { value: AsyncValue<S, V>; callback?: Callback<S, V, R> | null; default?: Callback<S, V, D> | null };
+
+/** The keys of the options form (AD-26), the camelCase PHP parameter names. */
+const OPTION_KEYS: ReadonlySet<string> = new Set(["value", "callback", "default"]);
+
+/** The arguments of a `when` / `unless` call, read from either form. */
+interface Arguments {
+  /** `func_num_args()`. */
+  readonly count: number;
+  readonly value: unknown;
+  readonly callback: unknown;
+  readonly defaultValue: unknown;
+}
+
+/** The options form of a call with `count` arguments whose first is `options`, or null when it is positional (see the header). */
+function readOptions(count: number, options: unknown): Arguments | null {
+  if (count !== 1) {
+    return null;
+  }
+  if (typeof options !== "object" || options === null || isContractToken(options)) {
+    return null;
+  }
+  const prototype: unknown = Object.getPrototypeOf(options);
+  if (prototype !== Object.prototype && prototype !== null) {
+    return null;
+  }
+  const keys = Reflect.ownKeys(options);
+  if (keys.length === 0 || !keys.every((key) => typeof key === "string" && OPTION_KEYS.has(key))) {
+    return null;
+  }
+  if (!Object.hasOwn(options, "callback") && !Object.hasOwn(options, "default")) {
+    return null;
+  }
+  const record = options as Record<string, unknown>;
+  for (const key of ["callback", "default"]) {
+    if (Object.hasOwn(record, key) && record[key] !== null && typeof record[key] !== "function") {
+      return null;
+    }
+  }
+  // PHP fills a skipped parameter with its default and counts up to the last one passed: at least 2 here.
+  return {
+    count: Object.hasOwn(record, "default") ? 3 : 2,
+    value: record["value"] ?? null,
+    callback: record["callback"] ?? null,
+    defaultValue: record["default"] ?? null,
+  };
+}
+
+/** The arguments of a call, in the options form or positionally (`undefined` read as `null`, AD-9). */
+function readArguments(count: number, value: unknown, callback: unknown, defaultValue: unknown): Arguments {
+  return readOptions(count, value) ?? { count, value: value ?? null, callback: callback ?? null, defaultValue: defaultValue ?? null };
+}
+
+/** PHP's `$value instanceof Closure`: a function that is not a class. */
+function isClosure(value: unknown): value is (self: unknown) => unknown {
+  return typeof value === "function" && !/^class\b/.test(Function.prototype.toString.call(value));
+}
+
+/** `$callable($self, $value)`; a value that is not callable throws PHP's `Error`, as Upstream's call does. */
+function invoke(callable: unknown, self: unknown, value: unknown): unknown {
+  if (typeof callable !== "function") {
+    throw new PhpError(callable === null ? "Value of type null is not callable" : "Value not callable");
+  }
+  return (callable as (self: unknown, value: unknown) => unknown)(self, value);
+}
+
+/** `$result ?? $this`, awaited first when the result is a Promise (AD-6). */
+function orSelf(result: unknown, self: unknown): unknown {
+  if (result instanceof Promise) {
+    return result.then((settled: unknown) => settled ?? self);
+  }
+  return result ?? self;
+}
+
+/** The body of `when` (`negate` false) and `unless` (`negate` true), from the condition's value on. */
+function settle(self: unknown, negate: boolean, args: Arguments, value: unknown): unknown {
+  if (args.count === 0) {
+    const proxy = new HigherOrderWhenProxy(self);
+
+    return negate ? proxy.negateConditionOnCapture() : proxy;
+  }
+
+  if (args.count === 1) {
+    return new HigherOrderWhenProxy(self).condition(negate ? !toBool(value) : value);
+  }
+
+  if (negate ? !toBool(value) : toBool(value)) {
+    return orSelf(invoke(args.callback, self, value), self);
+  } else if (toBool(args.defaultValue)) {
+    return orSelf(invoke(args.defaultValue, self, value), self);
+  }
+
+  return self;
+}
+
+/** `when` / `unless` called with `count` arguments: resolves a closure value, awaits a Promise condition (AD-6), then settles. */
+function conditional(self: unknown, negate: boolean, count: number, value: unknown, callback: unknown, defaultValue: unknown): unknown {
+  const args = readArguments(count, value, callback, defaultValue);
+  const resolved: unknown = isClosure(args.value) ? args.value(self) : args.value;
+
+  if (resolved instanceof Promise) {
+    return resolved.then((settled: unknown) => settle(self, negate, args, settled));
+  }
+
+  return settle(self, negate, args, resolved);
+}
+
+/**
+ * Laravel's `Conditionable` trait: `when()` and `unless()` apply a callback only when a condition holds, so a fluent
+ * chain can branch without leaving the chain. Use it as `class X extends mixin(Base, Conditionable)`.
+ */
+export class Conditionable {
+  /** With no argument: a `HigherOrderWhenProxy` whose next property read or method call captures the condition. */
+  when(): HigherOrderWhenProxy<this>;
+  /**
+   * The options form (AD-26), with a `value` that settles later: a Promise of what the sync form returns.
+   *
+   * @asyncRoot callback
+   */
+  when<V, R = never, D = never>(options: AsyncValueOptions<this, V, R, D> & Given<"callback", Callback<this, V, R> | null>): Promise<Result<Awaited<R> | Awaited<D>, this>>;
+  /**
+   * The options form (AD-26), with a `value` that settles later and a `default`: a Promise of what the sync form
+   * returns.
+   *
+   * @asyncRoot callback
+   */
+  when<V, R = never, D = never>(options: AsyncValueOptions<this, V, R, D> & Given<"default", Callback<this, V, D> | null>): Promise<Result<Awaited<R> | Awaited<D>, this>>;
+  /**
+   * The options form (AD-26), with an async `callback`: a Promise of what the sync form returns.
+   *
+   * @asyncRoot callback
+   */
+  when<V, R, D = never>(options: ValueOptions<this, V, Promise<R>, D> & Given<"callback", Callback<this, V, Promise<R>>>): Promise<Result<R | Awaited<D>, this>>;
+  /**
+   * The options form (AD-26), with an async `default`: a Promise of what the sync form returns.
+   *
+   * @asyncRoot callback
+   */
+  when<V, D, R = never>(options: ValueOptions<this, V, R, Promise<D>> & Given<"default", Callback<this, V, Promise<D>>>): Promise<Result<Awaited<R> | D, this>>;
+  /** The options form (AD-26), with a sync `callback`: `when(value, callback, default)`. */
+  when<V, R = never, D = never>(options: ValueOptions<this, V, NotPromise<R>, NotPromise<D>> & Given<"callback", Callback<this, V, NotPromise<R>> | null>): Result<R | D, this>;
+  /** The options form (AD-26), with a sync `default` and no `callback`: `when(value, null, default)`. */
+  when<V, R = never, D = never>(options: ValueOptions<this, V, NotPromise<R>, NotPromise<D>> & Given<"default", Callback<this, V, NotPromise<D>> | null>): Result<R | D, this>;
+  /**
+   * With only a condition that settles later: a Promise of the `HigherOrderWhenProxy` holding its value.
+   *
+   * @asyncRoot callback
+   */
+  when<V>(value: AsyncValue<this, V>): Promise<HigherOrderWhenProxy<this>>;
+  /** With only a condition: a `HigherOrderWhenProxy` that applies the next property read or method call when it is truthy. */
+  when<V>(value: Value<this, V>): HigherOrderWhenProxy<this>;
+  /**
+   * With a condition that settles later: a Promise of what the sync form returns.
+   *
+   * @asyncRoot callback
+   */
+  when<V, R = never, D = never>(
+    value: AsyncValue<this, V>,
+    callback: Callback<this, V, R> | null,
+    defaultValue?: Callback<this, V, D> | null,
+  ): Promise<Result<Awaited<R> | Awaited<D>, this>>;
+  /**
+   * With an async `callback`: a Promise of what the sync form returns.
+   *
+   * @asyncRoot callback
+   */
+  when<V, R, D = never>(
+    value: Value<this, V>,
+    callback: Callback<this, V, Promise<R>>,
+    defaultValue?: Callback<this, V, D> | null,
+  ): Promise<Result<R | Awaited<D>, this>>;
+  /**
+   * With an async `default`: a Promise of what the sync form returns.
+   *
+   * @asyncRoot callback
+   */
+  when<V, D, R = never>(
+    value: Value<this, V>,
+    callback: Callback<this, V, R> | null,
+    defaultValue: Callback<this, V, Promise<D>>,
+  ): Promise<Result<Awaited<R> | D, this>>;
+  /**
+   * Apply the callback if the given "value" is (or resolves to) truthy. A `value` closure is called with the instance,
+   * and its result is the value. When the value is truthy, returns `callback(this, value)`; otherwise, when a `default`
+   * is given, `default(this, value)`; a `null` result, or no callback run, returns the instance.
+   */
+  when<V, R = never, D = never>(
+    value?: Value<this, V>,
+    callback?: Callback<this, V, NotPromise<R>> | null,
+    defaultValue?: Callback<this, V, NotPromise<D>> | null,
+  ): Result<R | D, this>;
+  /** The options form (AD-26) of `when(value, callback, default)`, keyed by the PHP parameter names. */
+  when<V, R = never, D = never>(options?: ValueOptions<this, V, NotPromise<R>, NotPromise<D>>): Result<R | D, this>;
+  // `arguments.length` stands in for Upstream's `func_num_args()`.
+  when(value: unknown = null, callback: unknown = null, defaultValue: unknown = null): unknown {
+    return conditional(this, false, arguments.length, value, callback, defaultValue);
+  }
+
+  /** With no argument: a `HigherOrderWhenProxy` whose next property read or method call captures the negated condition. */
+  unless(): HigherOrderWhenProxy<this>;
+  /**
+   * The options form (AD-26), with a `value` that settles later: a Promise of what the sync form returns.
+   *
+   * @asyncRoot callback
+   */
+  unless<V, R = never, D = never>(options: AsyncValueOptions<this, V, R, D> & Given<"callback", Callback<this, V, R> | null>): Promise<Result<Awaited<R> | Awaited<D>, this>>;
+  /**
+   * The options form (AD-26), with a `value` that settles later and a `default`: a Promise of what the sync form
+   * returns.
+   *
+   * @asyncRoot callback
+   */
+  unless<V, R = never, D = never>(options: AsyncValueOptions<this, V, R, D> & Given<"default", Callback<this, V, D> | null>): Promise<Result<Awaited<R> | Awaited<D>, this>>;
+  /**
+   * The options form (AD-26), with an async `callback`: a Promise of what the sync form returns.
+   *
+   * @asyncRoot callback
+   */
+  unless<V, R, D = never>(options: ValueOptions<this, V, Promise<R>, D> & Given<"callback", Callback<this, V, Promise<R>>>): Promise<Result<R | Awaited<D>, this>>;
+  /**
+   * The options form (AD-26), with an async `default`: a Promise of what the sync form returns.
+   *
+   * @asyncRoot callback
+   */
+  unless<V, D, R = never>(options: ValueOptions<this, V, R, Promise<D>> & Given<"default", Callback<this, V, Promise<D>>>): Promise<Result<Awaited<R> | D, this>>;
+  /** The options form (AD-26), with a sync `callback`: `unless(value, callback, default)`. */
+  unless<V, R = never, D = never>(options: ValueOptions<this, V, NotPromise<R>, NotPromise<D>> & Given<"callback", Callback<this, V, NotPromise<R>> | null>): Result<R | D, this>;
+  /** The options form (AD-26), with a sync `default` and no `callback`: `unless(value, null, default)`. */
+  unless<V, R = never, D = never>(options: ValueOptions<this, V, NotPromise<R>, NotPromise<D>> & Given<"default", Callback<this, V, NotPromise<D>> | null>): Result<R | D, this>;
+  /**
+   * With only a condition that settles later: a Promise of the `HigherOrderWhenProxy` holding its negated value.
+   *
+   * @asyncRoot callback
+   */
+  unless<V>(value: AsyncValue<this, V>): Promise<HigherOrderWhenProxy<this>>;
+  /** With only a condition: a `HigherOrderWhenProxy` that applies the next property read or method call when it is falsy. */
+  unless<V>(value: Value<this, V>): HigherOrderWhenProxy<this>;
+  /**
+   * With a condition that settles later: a Promise of what the sync form returns.
+   *
+   * @asyncRoot callback
+   */
+  unless<V, R = never, D = never>(
+    value: AsyncValue<this, V>,
+    callback: Callback<this, V, R> | null,
+    defaultValue?: Callback<this, V, D> | null,
+  ): Promise<Result<Awaited<R> | Awaited<D>, this>>;
+  /**
+   * With an async `callback`: a Promise of what the sync form returns.
+   *
+   * @asyncRoot callback
+   */
+  unless<V, R, D = never>(
+    value: Value<this, V>,
+    callback: Callback<this, V, Promise<R>>,
+    defaultValue?: Callback<this, V, D> | null,
+  ): Promise<Result<R | Awaited<D>, this>>;
+  /**
+   * With an async `default`: a Promise of what the sync form returns.
+   *
+   * @asyncRoot callback
+   */
+  unless<V, D, R = never>(
+    value: Value<this, V>,
+    callback: Callback<this, V, R> | null,
+    defaultValue: Callback<this, V, Promise<D>>,
+  ): Promise<Result<Awaited<R> | D, this>>;
+  /**
+   * Apply the callback if the given "value" is (or resolves to) falsy. A `value` closure is called with the instance,
+   * and its result is the value. When the value is falsy, returns `callback(this, value)`; otherwise, when a `default`
+   * is given, `default(this, value)`; a `null` result, or no callback run, returns the instance.
+   */
+  unless<V, R = never, D = never>(
+    value?: Value<this, V>,
+    callback?: Callback<this, V, NotPromise<R>> | null,
+    defaultValue?: Callback<this, V, NotPromise<D>> | null,
+  ): Result<R | D, this>;
+  /** The options form (AD-26) of `unless(value, callback, default)`, keyed by the PHP parameter names. */
+  unless<V, R = never, D = never>(options?: ValueOptions<this, V, NotPromise<R>, NotPromise<D>>): Result<R | D, this>;
+  // `arguments.length` stands in for Upstream's `func_num_args()`.
+  unless(value: unknown = null, callback: unknown = null, defaultValue: unknown = null): unknown {
+    return conditional(this, true, arguments.length, value, callback, defaultValue);
+  }
+}
+
+registerClass("Illuminate\\Support\\Traits\\Conditionable", Conditionable);
