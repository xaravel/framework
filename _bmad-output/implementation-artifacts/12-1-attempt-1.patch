+// Ported from framework/tests/Support/SupportConditionableTest.php (Laravel v13.37.0), Story 12.1.
+//
+// The closures use no `$this`, so they are arrow functions (PORTING.md § Mechanical expression rule / By hand), typed
+// with the narrowest type the call site gives. `ConditionableLogger` is the Upstream fixture, registered in `setUp`
+// with `registerTestClass`. `in_array` is loose, so `has` compares with `looseEquals`.
+//
+// `testWhenProxy` and `testUnlessProxy` are not ported: they reach the target's `log` / `has` methods and `toggle`
+// property through the proxy's PHP `__call` / `__get`, which Xaravel has no form for, and the fixture's `$toggle`
+// property and `toggle()` method cannot share one JavaScript name (conformance/escalations/ESC-12.1-1.md). So the
+// fixture here leaves out `$toggle` and `toggle()`, which only those two tests use.
+import { portedTest, TestCase } from "@xaravel/assert";
+import { Conditionable } from "@xaravel/conditionable";
+import { looseEquals, mixin, registerTestClass } from "@xaravel/runtime";
+
+const ID = "Illuminate\\Tests\\Support\\SupportConditionableTest";
+
+class ConditionableLogger extends mixin(null, Conditionable) {
+  values: unknown[] = [];
+
+  // `public $toggle = false;` and `toggle()` are left out (ESC-12.1-1).
+
+  log(...values: unknown[]): this {
+    this.values.push(...values);
+
+    return this;
+  }
+
+  has(value: unknown): boolean {
+    return this.values.some((item) => looseEquals(item, value));
+  }
+}
+
+class SupportConditionableTest extends TestCase {
+  setUp(): void {
+    registerTestClass("Illuminate\\Tests\\Support\\ConditionableLogger", ConditionableLogger);
+  }
+}
+
+portedTest(`${ID}::testWhenConditionCallback`, { case: SupportConditionableTest }, async function () {
+  // With static condition
+  let logger = new ConditionableLogger().when(
+    2,
+    (logger: ConditionableLogger, condition: unknown) => {
+      logger.log("when", condition);
+    },
+    (logger: ConditionableLogger, condition: unknown) => {
+      logger.log("default", condition);
+    },
+  );
+
+  this.assertSame(["when", 2], logger.values);
+
+  // With callback condition
+  logger = new ConditionableLogger()
+    .log("init")
+    .when(
+      (logger: ConditionableLogger) => {
+        return logger.has("init");
+      },
+      (logger: ConditionableLogger, condition: unknown) => {
+        logger.log("when", condition);
+      },
+      (logger: ConditionableLogger, condition: unknown) => {
+        logger.log("default", condition);
+      },
+    );
+
+  this.assertSame(["init", "when", true], logger.values);
+});
+
+portedTest(`${ID}::testWhenDefaultCallback`, { case: SupportConditionableTest }, async function () {
+  // With static condition
+  let logger = new ConditionableLogger().when(
+    null,
+    (logger: ConditionableLogger, condition: unknown) => {
+      logger.log("when", condition);
+    },
+    (logger: ConditionableLogger, condition: unknown) => {
+      logger.log("default", condition);
+    },
+  );
+
+  this.assertSame(["default", null], logger.values);
+
+  // With callback condition
+  logger = new ConditionableLogger().when(
+    (logger: ConditionableLogger) => {
+      return logger.has("missing");
+    },
+    (logger: ConditionableLogger, condition: unknown) => {
+      logger.log("when", condition);
+    },
+    (logger: ConditionableLogger, condition: unknown) => {
+      logger.log("default", condition);
+    },
+  );
+
+  this.assertSame(["default", false], logger.values);
+});
+
+portedTest(`${ID}::testUnlessConditionCallback`, { case: SupportConditionableTest }, async function () {
+  // With static condition
+  let logger = new ConditionableLogger().unless(
+    null,
+    (logger: ConditionableLogger, condition: unknown) => {
+      logger.log("unless", condition);
+    },
+    (logger: ConditionableLogger, condition: unknown) => {
+      logger.log("default", condition);
+    },
+  );
+
+  this.assertSame(["unless", null], logger.values);
+
+  // With callback condition
+  logger = new ConditionableLogger().unless(
+    (logger: ConditionableLogger) => {
+      return logger.has("missing");
+    },
+    (logger: ConditionableLogger, condition: unknown) => {
+      logger.log("unless", condition);
+    },
+    (logger: ConditionableLogger, condition: unknown) => {
+      logger.log("default", condition);
+    },
+  );
+
+  this.assertSame(["unless", false], logger.values);
+});
+
+portedTest(`${ID}::testUnlessDefaultCallback`, { case: SupportConditionableTest }, async function () {
+  // With static condition
+  let logger = new ConditionableLogger().unless(
+    2,
+    (logger: ConditionableLogger, condition: unknown) => {
+      logger.log("unless", condition);
+    },
+    (logger: ConditionableLogger, condition: unknown) => {
+      logger.log("default", condition);
+    },
+  );
+
+  this.assertSame(["default", 2], logger.values);
+
+  // With callback condition
+  logger = new ConditionableLogger()
+    .log("init")
+    .unless(
+      (logger: ConditionableLogger) => {
+        return logger.has("init");
+      },
+      (logger: ConditionableLogger, condition: unknown) => {
+        logger.log("unless", condition);
+      },
+      (logger: ConditionableLogger, condition: unknown) => {
+        logger.log("default", condition);
+      },
+    );
+
+  this.assertSame(["init", "default", true], logger.values);
+});
diff --git a/packages/conditionable/tests/xaravel/conditionable.test.ts b/packages/conditionable/tests/xaravel/conditionable.test.ts
new file mode 100644
index 00000000..eb1af25f
--- /dev/null
+++ b/packages/conditionable/tests/xaravel/conditionable.test.ts
@@ -0,0 +1,302 @@
+// Xaravel Tests for Story 12.1: `Conditionable` as a runtime trait with Upstream's closure values and higher-order proxy
+// (XT-conditionable-1), its AD-6 dual-helper behaviour (XT-conditionable-2) and the package's close gate
+// (XT-conditionable-3). Registrations into the Class Registry are process-wide, so every FQCN here is used by this file
+// only.
+import { spawnSync, type SpawnSyncReturns } from "node:child_process";
+import { existsSync, readFileSync } from "node:fs";
+import { join, resolve } from "node:path";
+import { Assert, xaravelTest } from "@xaravel/assert";
+import { Conditionable, HigherOrderWhenProxy } from "@xaravel/conditionable";
+import { classUsesRecursive, Error as PhpError, fqcn, looseEquals, mixin, registerClass } from "@xaravel/runtime";
+
+const REPO = resolve(import.meta.dir, "..", "..", "..", "..");
+const PACKAGE = join(REPO, "packages", "conditionable");
+
+class Logger extends mixin(null, Conditionable) {
+  values: unknown[] = [];
+
+  flag: unknown = false;
+
+  log(...values: unknown[]): this {
+    this.values.push(...values);
+
+    return this;
+  }
+
+  has(value: unknown): boolean {
+    return this.values.some((item) => looseEquals(item, value));
+  }
+}
+
+registerClass("Xaravel\\Tests\\Conditionable\\Logger", Logger);
+
+/** What the proxy's `__call` returned, as the type the check expects (the proxy types its results `unknown`). */
+function as<T>(value: unknown): T {
+  return value as T;
+}
+
+xaravelTest(
+  "XT-conditionable-1",
+  "`when(value, callback, default)` / `unless(...)` follow Upstream: a closure value is called with the instance and its result decides the branch by PHP truthiness; a null callback result returns the instance; with no callback they return a HigherOrderWhenProxy whose __call / __get capture and apply conditions (unless() negating on capture); the AD-26 options form is read narrowly; classUsesRecursive names the trait's FQCN",
+  () => {
+    // The value closure is called with the instance; its result is the condition, passed on to the callback.
+    const seen: unknown[] = [];
+    const logger = new Logger().log("init");
+    const result = logger.when(
+      (self: Logger) => {
+        seen.push(self);
+        return self.has("init") ? "yes" : "";
+      },
+      (self: Logger, value: unknown) => {
+        seen.push(self, value);
+        return "callback-result";
+      },
+    );
+    Assert.assertSame("callback-result", result);
+    Assert.assertSame([logger, logger, "yes"], seen);
+
+    // PHP truthiness: "0", "", 0, an empty array and null are falsy; "a", [0] and an object are truthy.
+    for (const falsy of ["0", "", 0, [], null, false]) {
+      Assert.assertSame(["default", falsy], new Logger().when((_self: Logger) => falsy, (self: Logger) => self.log("when"), (self: Logger, value: unknown) => self.log("default", value)).values);
+      Assert.assertSame(["unless", falsy], new Logger().unless(falsy, (self: Logger, value: unknown) => self.log("unless", value)).values);
+    }
+    for (const truthy of ["a", "0.0", [0], 1, { a: 1 }]) {
+      Assert.assertSame(["when", truthy], new Logger().when(truthy, (self: Logger, value: unknown) => self.log("when", value)).values);
+    }
+
+    // A falsy value with no default returns the instance; a null or undefined callback result returns it too.
+    const plain = new Logger();
+    Assert.assertSame(plain, plain.when(false, () => "never"));
+    Assert.assertSame(plain, plain.when(true, () => null));
+    Assert.assertSame(plain, plain.when(true, () => {}));
+    Assert.assertSame(plain, plain.unless(true, null));
+    Assert.assertSame(plain, plain.when(false, null));
+    Assert.assertSame("default-result", plain.when(0, null, () => "default-result"));
+
+    // Upstream calls a null callback when the value is truthy: PHP's Error.
+    let thrown: unknown = null;
+    try {
+      plain.when(true, null);
+    } catch (error) {
+      thrown = error;
+    }
+    Assert.assertInstanceOf(PhpError, thrown);
+    Assert.assertSame("Value of type null is not callable", (thrown as Error).message);
+
+    // A class is not a closure: it is the value itself.
+    Assert.assertSame(["when", Logger], new Logger().when(Logger, (self: Logger, value: unknown) => self.log("when", value)).values);
+
+    // No argument: a proxy with no condition; the next call captures it.
+    const proxy = new Logger().log("init").when();
+    Assert.assertInstanceOf(HigherOrderWhenProxy, proxy);
+    Assert.assertSame("Illuminate\\Support\\HigherOrderWhenProxy", fqcn(proxy));
+    const captured = as<HigherOrderWhenProxy<Logger>>(proxy.__call("has", ["init"]));
+    Assert.assertSame(proxy, captured);
+    Assert.assertSame(["init", "three"], as<Logger>(captured.__call("log", ["three"])).values);
+
+    const missing = new Logger().log("init");
+    Assert.assertSame(missing, as<HigherOrderWhenProxy<Logger>>(missing.when().__call("has", ["missing"])).__call("log", ["four"]));
+    Assert.assertSame(["init"], missing.values);
+
+    // __get captures a property's value as the condition, then applies or skips the next read or call.
+    const flagged = new Logger();
+    flagged.flag = "1";
+    Assert.assertSame(["five"], as<Logger>(as<HigherOrderWhenProxy<Logger>>(flagged.when().__get("flag")).__call("log", ["five"])).values);
+    flagged.flag = "0";
+    Assert.assertSame(flagged, as<HigherOrderWhenProxy<Logger>>(flagged.when().__get("flag")).__get("values"));
+
+    // unless(): the captured condition is negated (PHP `!`).
+    const negated = new Logger().log("init");
+    Assert.assertSame(negated, as<HigherOrderWhenProxy<Logger>>(negated.unless().__call("has", ["init"])).__call("log", ["three"]));
+    Assert.assertSame(["init", "four"], as<Logger>(as<HigherOrderWhenProxy<Logger>>(negated.unless().__call("has", ["missing"])).__call("log", ["four"])).values);
+    negated.flag = false;
+    Assert.assertSame(["init", "four", "five"], as<Logger>(as<HigherOrderWhenProxy<Logger>>(negated.unless().__get("flag")).__call("log", ["five"])).values);
+
+    // One argument: the proxy holds the condition (negated by unless); a false condition returns the target uncalled.
+    const one = new Logger();
+    Assert.assertSame(["a"], as<Logger>(one.when(true).__call("log", ["a"])).values);
+    Assert.assertSame(one, one.when(false).__call("log", ["b"]));
+    Assert.assertSame(one, one.unless(true).__call("log", ["c"]));
+    Assert.assertSame(["a", "d"], as<Logger>(one.unless(false).__call("log", ["d"])).values);
+    Assert.assertSame(["a", "d", "e"], as<Logger>(one.when((self: Logger) => self.has("a")).__call("log", ["e"])).values);
+    Assert.assertSame(one, one.unless((self: Logger) => self.has("a")).__call("log", ["f"]));
+    Assert.assertSame(["a", "d", "e"], one.when("1").__get("values"));
+    Assert.assertSame(one, one.when("0").__get("values"));
+    // condition() and negateConditionOnCapture() return the proxy.
+    const bare = new HigherOrderWhenProxy(one);
+    Assert.assertSame(bare, bare.negateConditionOnCapture());
+    Assert.assertSame(bare, bare.condition(false));
+    Assert.assertSame(one, bare.__call("log", ["g"]));
+
+    // The options form (AD-26) is `when(value, callback, default)`.
+    Assert.assertSame(["when", true], new Logger().when({ value: true, callback: (self: Logger, value: unknown) => self.log("when", value) }).values);
+    Assert.assertSame(["default", 0], new Logger().when({ value: 0, callback: null, default: (self: Logger, value: unknown) => self.log("default", value) }).values);
+    Assert.assertSame(["default", null], new Logger().when({ default: (self: Logger, value: unknown) => self.log("default", value) }).values);
+    Assert.assertSame(["unless", false], new Logger().unless({ value: (_self: Logger) => false, callback: (self: Logger, value: unknown) => self.log("unless", value) }).values);
+    // Any other object is a value: a plain object with other keys, `{ value }` alone, a non-callable `callback`, or a
+    // second argument.
+    Assert.assertSame(["when", { a: 1 }], new Logger().when({ a: 1 }, (self: Logger, value: unknown) => self.log("when", value)).values);
+    Assert.assertInstanceOf(HigherOrderWhenProxy, new Logger().when({ a: 1 }));
+    Assert.assertInstanceOf(HigherOrderWhenProxy, new Logger().when({ value: true }));
+    Assert.assertInstanceOf(HigherOrderWhenProxy, new Logger().when({ callback: "strrev" }));
+    Assert.assertInstanceOf(HigherOrderWhenProxy, new Logger().when({ value: true, callback: () => 1, extra: 1 }));
+    Assert.assertSame("second", new Logger().when({ value: false, callback: () => "first" }, () => "second"));
+
+    // The trait is registered under its Upstream FQCN.
+    Assert.assertContains("Illuminate\\Support\\Traits\\Conditionable", Object.values(classUsesRecursive(Logger)));
+    Assert.assertSame("Illuminate\\Support\\Traits\\Conditionable", fqcn(Conditionable));
+  },
+);
+
+/** A thenable that is not a Promise, as a query Builder is: `then` must never be called by `when`. */
+class FakeBuilder {
+  thenCalls = 0;
+
+  then(resolve: (value: string) => void): void {
+    this.thenCalls++;
+    resolve("ran");
+  }
+}
+
+xaravelTest(
+  "XT-conditionable-2",
+  "`when` / `unless` are AD-6 dual helpers (DIV-1): an async callback, default or value closure makes them return a Promise of the sync result, a Promise condition is awaited rather than tested for truthiness, a sync callback returns its result (not a Promise), a thenable that is not a Promise stays sync and unawaited, and async-surface.json lists Conditionable.when / unless with root callback",
+  async () => {
+    const logger = new Logger();
+
+    // An async callback: a Promise of its result, or of the instance for a null result.
+    const viaCallback = logger.when(true, async () => 1);
+    Assert.assertInstanceOf(Promise, viaCallback);
+    Assert.assertSame(1, await viaCallback);
+    Assert.assertSame(logger, await logger.when(true, async () => null));
+    Assert.assertSame(logger, await logger.unless(false, async () => {}));
+
+    // An async default.
+    const viaDefault = logger.unless(true, null, async (self: Logger, value: unknown) => self.log("default", value));
+    Assert.assertInstanceOf(Promise, viaDefault);
+    Assert.assertSame(logger, await viaDefault);
+    Assert.assertSame(["default", true], logger.values);
+
+    // An async value closure: the default runs only after the value settles, with the settled value.
+    const order: string[] = [];
+    const viaValue = new Logger().when(
+      async (_self: Logger) => {
+        order.push("value");
+        await Promise.resolve();
+        order.push("settled");
+        return false;
+      },
+      () => {
+        order.push("callback");
+        return "callback";
+      },
+      (_self: Logger, value: unknown) => {
+        order.push(`default:${String(value)}`);
+        return "default";
+      },
+    );
+    Assert.assertInstanceOf(Promise, viaValue);
+    order.push("returned");
+    Assert.assertSame("default", await viaValue);
+    Assert.assertSame(["value", "returned", "settled", "default:false"], order);
+
+    // A Promise condition is awaited, never truthy: a Promise of false takes the default.
+    Assert.assertSame("default", await new Logger().when(Promise.resolve(false), () => "callback", () => "default"));
+    Assert.assertSame("callback", await new Logger().unless(Promise.resolve(0), () => "callback"));
+
+    // With only an async condition: a Promise of the proxy holding its settled value.
+    const proxied = new Logger();
+    const proxy = await proxied.when(async (_self: Logger) => false);
+    Assert.assertInstanceOf(HigherOrderWhenProxy, proxy);
+    Assert.assertSame(proxied, proxy.__call("log", ["never"]));
+    Assert.assertSame([], proxied.values);
+    const negatedProxy = await proxied.unless(async () => 0);
+    Assert.assertSame(["yes"], as<Logger>(negatedProxy.__call("log", ["yes"])).values);
+
+    // The options form takes the same path.
+    Assert.assertSame(2, await new Logger().when({ value: true, callback: async () => 2 }));
+
+    // A rejection propagates.
+    let rejected: unknown = null;
+    try {
+      await logger.when(true, async () => {
+        throw new RangeError("boom");
+      });
+    } catch (error) {
+      rejected = error;
+    }
+    Assert.assertInstanceOf(RangeError, rejected);
+
+    // A sync callback returns its result as is.
+    const sync = logger.when(true, () => "sync");
+    Assert.assertNotInstanceOf(Promise, sync);
+    Assert.assertSame("sync", sync);
+
+    // A thenable that is not a Promise is an ordinary value: returned sync, its `then` never called.
+    const builder = new FakeBuilder();
+    const kept: unknown = logger.when(true, () => builder);
+    Assert.assertSame(builder, kept);
+    Assert.assertSame(0, builder.thenCalls);
+    Assert.assertSame(logger, logger.when(builder, () => null));
+    Assert.assertSame(0, builder.thenCalls);
+
+    // The committed async surface lists both methods with the `callback` root.
+    const surface = readFileSync(join(PACKAGE, "async-surface.json"), "utf8");
+    Assert.assertStringContainsString('{"method":"Conditionable.when","file":"src/Traits/Conditionable.ts","root":"callback"}', surface);
+    Assert.assertStringContainsString('{"method":"Conditionable.unless","file":"src/Traits/Conditionable.ts","root":"callback"}', surface);
+  },
+);
+
+/** Spawns `bun run <script> …args` from the repository root, without colour. */
+function bunRun(script: string, args: readonly string[]): SpawnSyncReturns<string> {
+  return spawnSync(process.execPath, ["run", script, ...args], { cwd: REPO, encoding: "utf8", timeout: 240000, env: { ...process.env, NO_COLOR: "1" } });
+}
+
+/** A run's stdout and stderr, with its spawn error, for a failure message. */
+function outputOf(run: SpawnSyncReturns<string>): string {
+  return `${run.error === undefined ? "" : `${String(run.error)}\n`}${run.stdout ?? ""}${run.stderr ?? ""}`;
+}
+
+/** The `## <title>` section of a markdown page, or "" when it has none. */
+function section(page: string, title: string): string {
+  const start = page.indexOf(`\n## ${title}\n`);
+  if (start === -1) {
+    return "";
+  }
+  const next = page.indexOf("\n## ", start + 1);
+  return page.slice(start, next === -1 ? page.length : next);
+}
+
+xaravelTest(
+  "XT-conditionable-3",
+  "@xaravel/conditionable is complete: `bun run api-surface:gate conditionable` reports 0 unexplained (AD-15); docs/conditionable.md documents when, unless and the proxy and has a Divergences section citing DIV-1 and DIV-12 and the open ESC-12.1-1..3, every DIV it cites exists, and the README links the docs page",
+  () => {
+    const gate = bunRun("api-surface:gate", ["conditionable"]);
+    Assert.assertSame(0, gate.status, outputOf(gate));
+    Assert.assertStringContainsString("api-surface:gate conditionable: 0 unexplained (AD-15)", gate.stdout ?? "", outputOf(gate));
+
+    const page = readFileSync(join(PACKAGE, "docs", "conditionable.md"), "utf8");
+    for (const name of ["when(", "unless(", "HigherOrderWhenProxy", "__call(", "__get("]) {
+      Assert.assertStringContainsString(name, page, `docs/conditionable.md documents ${name}`);
+    }
+    const divergences = section(page, "Divergences");
+    Assert.assertNotSame("", divergences, "docs/conditionable.md has a ## Divergences section");
+    for (const cited of ["DIV-1", "DIV-12", "ESC-12.1-1", "ESC-12.1-2", "ESC-12.1-3"]) {
+      Assert.assertStringContainsString(cited, divergences);
+    }
+    for (const match of divergences.matchAll(/\bDIV-(\d+)\b/g)) {
+      Assert.assertTrue(existsSync(join(REPO, "decisions", `DIV-${match[1] ?? ""}.md`)), `DIV-${match[1] ?? ""} is cited but does not exist`);
+    }
+    for (const match of divergences.matchAll(/\bDIV-(\d+)\.(\d+)\b/g)) {
+      const record = readFileSync(join(REPO, "decisions", `DIV-${match[1] ?? ""}.md`), "utf8");
+      Assert.assertStringContainsString(`**${match[0]}**`, record, `${match[0]} is cited but is not a clause of decisions/DIV-${match[1] ?? ""}.md`);
+    }
+    for (const match of divergences.matchAll(/\bESC-12\.1-(\d+)\b/g)) {
+      Assert.assertTrue(existsSync(join(REPO, "conformance", "escalations", `ESC-12.1-${match[1] ?? ""}.md`)), `${match[0]} is cited but does not exist`);
+    }
+
+    const readme = readFileSync(join(PACKAGE, "README.md"), "utf8");
+    Assert.assertStringContainsString("(docs/conditionable.md)", readme, "README.md links docs/conditionable.md");
+  },
+  300000,
+);
