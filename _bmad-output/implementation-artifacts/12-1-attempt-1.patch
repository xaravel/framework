+// Laravel's `Illuminate\Support\HigherOrderWhenProxy` (Story 12.1), what `when()` / `unless()` return when they are
+// called with no callback.
+//
+// Upstream answers any property read or method call on the proxy through PHP's `__get` / `__call`. Xaravel has no
+// Proxy outside `Model` and installs no forwarding members (AD-7, AD-26), so the two magic methods are ported as
+// explicit methods: `proxy.__call('log', ['one'])` is Upstream's `$proxy->log('one')`, and `proxy.__get('toggle')` is
+// `$proxy->toggle`. How a bare `proxy.log('one')` reaches the target is open (conformance/escalations/ESC-12.1-1.md).
+//
+// `condition` and `negateConditionOnCapture` are both a method and protected state in Upstream. JavaScript has one
+// namespace per object, so the methods keep the names and the state is held under `conditionState` and
+// `negateConditionOnCaptureState` (DIV-12.2; PORTING.md § DIV-12 pair list).
+import { normalizeNull, registerClass, toBool } from "@xaravel/runtime";
+
+/**
+ * A proxy that applies the next property read or method call to its target only when a condition holds. With no
+ * condition yet, the next read or call captures one instead: its result becomes the condition.
+ */
+export class HigherOrderWhenProxy<T = unknown> {
+  /** The target being conditionally operated on. */
+  protected target: T;
+
+  /** The condition for proxying (Upstream's `$condition`). */
+  protected conditionState: unknown = null;
+
+  /** Indicates whether the proxy has a condition. */
+  protected hasCondition: boolean = false;
+
+  /** Determine whether the condition should be negated (Upstream's `$negateConditionOnCapture`). */
+  protected negateConditionOnCaptureState: boolean | null = null;
+
+  /** Create a new proxy instance. */
+  constructor(target: T) {
+    this.target = target;
+  }
+
+  /** Set the condition on the proxy. */
+  condition(condition: unknown): this {
+    [this.conditionState, this.hasCondition] = [normalizeNull(condition), true];
+
+    return this;
+  }
+
+  /** Indicate that the condition should be negated. */
+  negateConditionOnCapture(): this {
+    this.negateConditionOnCaptureState = true;
+
+    return this;
+  }
+
+  /**
+   * Proxy accessing an attribute onto the target: Upstream's `$proxy->{$key}`. With no condition, the attribute's value
+   * becomes the condition (negated when `negateConditionOnCapture()` was called) and the proxy is returned. Otherwise the
+   * attribute's value when the condition is truthy, and the target when it is not.
+   */
+  __get(key: string): unknown {
+    if (!this.hasCondition) {
+      const condition = this.read(key);
+
+      return this.condition(toBool(this.negateConditionOnCaptureState) ? !toBool(condition) : condition);
+    }
+
+    return toBool(this.conditionState) ? this.read(key) : this.target;
+  }
+
+  /**
+   * Proxy a method call on the target: Upstream's `$proxy->{$method}(...$parameters)`. With no condition, the call's
+   * result becomes the condition (negated when `negateConditionOnCapture()` was called) and the proxy is returned.
+   * Otherwise the call's result when the condition is truthy, and the target, without calling it, when it is not.
+   */
+  __call(method: string, parameters: unknown[]): unknown {
+    if (!this.hasCondition) {
+      const condition = this.call(method, parameters);
+
+      return this.condition(toBool(this.negateConditionOnCaptureState) ? !toBool(condition) : condition);
+    }
+
+    return toBool(this.conditionState) ? this.call(method, parameters) : this.target;
+  }
+
+  /** `$this->target->{$key}`, with `undefined` read as `null` (AD-9). */
+  private read(key: string): unknown {
+    return normalizeNull((this.target as Record<string, unknown>)[key]);
+  }
+
+  /** `$this->target->{$method}(...$parameters)`, with an `undefined` result read as `null` (AD-9). */
+  private call(method: string, parameters: readonly unknown[]): unknown {
+    const target = this.target as Record<string, (...args: unknown[]) => unknown>;
+
+    return normalizeNull(target[method]!(...parameters));
+  }
+}
+
+registerClass("Illuminate\\Support\\HigherOrderWhenProxy", HigherOrderWhenProxy);
