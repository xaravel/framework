+function unescapeXml(text: string): string {
+  return text.replace(/&(#\d+|quot|amp|lt|gt|apos);/g, (_, entity: string) => {
+    switch (entity) {
+      case "quot":
+        return '"';
+      case "amp":
+        return "&";
+      case "lt":
+        return "<";
+      case "gt":
+        return ">";
+      case "apos":
+        return "'";
+      default:
+        return String.fromCodePoint(Number(entity.slice(1)));
+    }
+  });
+}
