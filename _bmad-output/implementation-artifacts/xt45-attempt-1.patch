index 0000000..e409693
--- /dev/null
+++ b/packages/mockery/tests/xaravel/cells.ts
@@ -0,0 +1,75 @@
+// Test-side comparison for XT-mockery-1..3: each scenario's TS outcome against
+// the Oracle's value for its expr, cell by cell, after normalising
+// `Mockery_<digits>` to `Mockery_<n>` and `#<32 hex>` identities to `#<id>`.
+import type { Mockery as MockeryClass } from "../../src/index";
+import { decode, type Output } from "../../../assert/tests/xaravel/oracle-values";
+import { runScenario, type Scenario } from "./scenarios";
+
+/** Replaces the generated-class counter and the object identities, which differ run to run. */
+export function normalize(value: unknown): unknown {
+  if (typeof value === "string") {
+    return value.replace(/Mockery_\d+/g, "Mockery_<n>").replace(/#[0-9a-f]{32}/g, "#<id>");
+  }
+  if (Array.isArray(value)) {
+    return value.map(normalize);
+  }
+  if (typeof value === "object" && value !== null && Object.getPrototypeOf(value) === Object.prototype) {
+    return Object.fromEntries(Object.entries(value).map(([key, item]) => [key, normalize(item)]));
+  }
+  return value;
+}
+
+/** A stable text of an outcome; `undefined` is spelled out so it is never taken for null (AD-9). */
+export function show(value: unknown): string {
+  if (value === undefined) {
+    return "undefined";
+  }
+  if (Array.isArray(value)) {
+    return `[${value.map(show).join(",")}]`;
+  }
+  if (typeof value === "object" && value !== null) {
+    if (Object.getPrototypeOf(value) !== Object.prototype) {
+      return `<object ${String((value as { constructor?: { name?: string } }).constructor?.name)}>`;
+    }
+    return `{${Object.entries(value)
+      .map(([key, item]) => `${JSON.stringify(key)}:${show(item)}`)
+      .join(",")}}`;
+  }
+  if (typeof value === "number" && !Number.isFinite(value)) {
+    return String(value);
+  }
+  return JSON.stringify(value);
+}
+
+/** The Oracle's normalised outcome of expr `index`. */
+export function oracleCell(output: Output, index: number, label: string): unknown {
+  if (output.error !== null) {
+    throw new Error(`${label}: the Oracle reported an error: ${JSON.stringify(output.error)}`);
+  }
+  const result = output.results[index];
+  if (result === undefined || !("value" in result)) {
+    throw new Error(`${label}: result ${index} is not a value: ${JSON.stringify(result ?? null)}`);
+  }
+  return normalize(decode(result.value));
+}
+
+/** Runs each scenario's TS twin and lists every cell that differs from the Oracle's. */
+export function scenarioMismatches(label: string, scenarios: readonly Scenario[], output: Output, Mockery: typeof MockeryClass): { cells: number; mismatches: string[] } {
+  if (output.error !== null) {
+    throw new Error(`${label}: the Oracle reported an error: ${JSON.stringify(output.error)}`);
+  }
+  if (output.results.length !== scenarios.length) {
+    throw new Error(`${label}: ${output.results.length} results for ${scenarios.length} scenarios`);
+  }
+  const mismatches: string[] = [];
+  let cells = 0;
+  scenarios.forEach((scenario, index) => {
+    const expected = show(oracleCell(output, index, label));
+    const actual = show(normalize(runScenario(Mockery, scenario)));
+    cells++;
+    if (expected !== actual) {
+      mismatches.push(`${label}: ${scenario.id} "${scenario.label}":\n  Oracle ${expected}\n  got    ${actual}`);
+    }
+  });
+  return { cells, mismatches };
+}
diff --git a/packages/mockery/tests/xaravel/fixtures/mockery.fixture.ts b/packages/mockery/tests/xaravel/fixtures/mockery.fixture.ts
new file mode 100644
index 0000000..497d1c1
--- /dev/null
+++ b/packages/mockery/tests/xaravel/fixtures/mockery.fixture.ts
@@ -0,0 +1,86 @@
+// Fixture for XT-mockery-2 (Story 4.5). Not collected by the root `bun test`
+// (its name matches no test glob); mockery.test.ts runs it explicitly:
+//
+//   bun test ./packages/mockery/tests/xaravel/fixtures/mockery.fixture.ts --reporter=junit
+//
+// Environment:
+//   XT_MOCKERY_REPORT_FILE  the harness reporter appends one JSON line per finished test
+//   XT_MOCKERY_PROBE_FILE   testPurged writes what it saw of the failed test's container
+//
+// Each Ported Test uses the real @xaravel/assert declarations, which run the
+// body through Mockery's test-finish protocol (ESC-4.5-1 item 1).
+import { appendFileSync, writeFileSync } from "node:fs";
+import { portedTest, xaravelTest } from "@xaravel/assert";
+import { type Container, Mockery } from "../../../src/index";
+import { XtFoo } from "../scenarios";
+
+const reportFile = process.env["XT_MOCKERY_REPORT_FILE"];
+const probeFile = process.env["XT_MOCKERY_PROBE_FILE"];
+
+(globalThis as Record<symbol, unknown>)[Symbol.for("xaravel.harness.report")] = (report: unknown): void => {
+  if (reportFile !== undefined) {
+    appendFileSync(reportFile, `${JSON.stringify(report)}\n`);
+  }
+};
+
+class CloseInTearDown {
+  tearDown(): void {
+    Mockery.close();
+  }
+}
+
+const T = "Tests\\Unit\\MockeryTest";
+
+// An unmet once(): the test fails with Mockery's message, and the expectation still counts.
+portedTest(`${T}::testUnmet`, {}, function () {
+  Mockery.mock(XtFoo).shouldReceive("bar").once();
+});
+
+// Only met expectations: the test passes and reports them.
+portedTest(`${T}::testMet`, {}, function () {
+  const m = Mockery.mock(XtFoo);
+  m.shouldReceive("bar").once().andReturn(1);
+  m.bar();
+  m.shouldReceive("baz").twice();
+  m.baz();
+  m.baz();
+  m.shouldReceive("qux");
+});
+
+// tearDown closes the container: each expectation counts once.
+portedTest(`${T}::testCloseInTearDown`, { case: CloseInTearDown }, function () {
+  const m = Mockery.mock(XtFoo);
+  m.shouldReceive("bar").once();
+  m.bar();
+  m.shouldReceive("qux").atLeast().once();
+  m.qux();
+});
+
+// tearDown's close verifies too: the unmet expectation fails the test, counted once.
+portedTest(`${T}::testUnmetCloseInTearDown`, { case: CloseInTearDown }, function () {
+  Mockery.mock(XtFoo).shouldReceive("bar").once();
+});
+
+let failedContainer: Container | null = null;
+
+// A failing body's error wins; the container is purged without verifying.
+portedTest(`${T}::testBodyFails`, {}, function () {
+  Mockery.mock(XtFoo).shouldReceive("bar").once();
+  failedContainer = Mockery.getContainer();
+  throw new Error("body failed");
+});
+
+portedTest(`${T}::testPurged`, {}, function () {
+  const m = Mockery.mock(XtFoo);
+  m.shouldReceive("bar").once();
+  m.bar();
+  if (probeFile !== undefined) {
+    const seen = failedContainer as Container | null;
+    writeFileSync(probeFile, JSON.stringify({ failedContainerMocks: seen === null ? null : seen.getMocks().length, fresh: seen !== Mockery.getContainer() }));
+  }
+});
+
+// A Xaravel Test runs through the protocol too.
+xaravelTest("XT-fixture-1", "an unmet Mockery expectation fails a Xaravel Test", () => {
+  Mockery.mock(XtFoo).shouldReceive("bar").once();
+});
diff --git a/packages/mockery/tests/xaravel/mockery.test.ts b/packages/mockery/tests/xaravel/mockery.test.ts
