+    scenario.run(Mockery, r);
+    Mockery.close();
+    return ["ok", r];
+  } catch (error) {
+    try {
+      Mockery.close();
+    } catch {
+      // ignored, as the PHP wrapper does
+    }
+    return ["throws", shortClassName(error), messageOf(error)];
+  }
+}
