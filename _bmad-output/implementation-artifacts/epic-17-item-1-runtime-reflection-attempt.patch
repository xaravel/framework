+// PHP 8.5.11 observations for XT-runtime-152 and XT-runtime-153.
+#[Attribute(Attribute::TARGET_PARAMETER)] class ExampleAttribute { function __construct(public string $value) {} }
+class Example { public int $value = 4; function __construct(string $value) {} }
+abstract class AbstractExample {}
+class ConcreteExample extends AbstractExample {}
+$fn = function (#[ExampleAttribute('first')] ?Example $value = null, string ...$rest) {};
+$p = new ReflectionParameter($fn, 'value');
+var_dump($p->isOptional(), $p->allowsNull(), $p->hasType(), $p->getDefaultValue(), $p->getAttributes()[0]->newInstance()->value);
+var_dump((new ReflectionParameter($fn, 1))->isVariadic());
+var_dump((new ReflectionClass(AbstractExample::class))->isInstantiable(), (new ReflectionClass(ConcreteExample::class))->isInstantiable());
+$o = new Example('x');
+var_dump((new ReflectionClass(Example::class))->getConstructor()->getName(), (new ReflectionProperty($o, 'value'))->getValue($o), spl_object_id($o) === spl_object_id($o), call_user_func(fn($x) => $x + 1, 2));
+try { (new ReflectionParameter($fn, 1))->getDefaultValue(); } catch (Throwable $e) { echo get_class($e), ': ', $e->getMessage(), "\n"; }
diff --git a/packages/runtime/tests/xaravel/container-reflection.test.ts b/packages/runtime/tests/xaravel/container-reflection.test.ts
new file mode 100644
index 00000000..1c845dc3
--- /dev/null
+++ b/packages/runtime/tests/xaravel/container-reflection.test.ts
@@ -0,0 +1,57 @@
+import { Assert, xaravelTest } from "@xaravel/assert";
+import { attributed, inject, nullable, oneOf, optional, primitive, variadic } from "@xaravel/runtime";
+import { abstractClass, Attribute, attribute, call_user_func, parameterAttribute, ReflectionClass, ReflectionException, ReflectionFunction, ReflectionParameter, ReflectionProperty, ReflectionUnionType, spl_object_id } from "@xaravel/runtime/php";
+import { registerClass } from "@xaravel/runtime/registry";
+
+@attribute(Attribute, Attribute.TARGET_PARAMETER)
+class ExampleAttribute { constructor(readonly value: string) {} }
+registerClass("RuntimeReflectionExampleAttribute", ExampleAttribute);
+class Example { value = 4; constructor(_value: string) {} }
+registerClass("RuntimeReflectionExample", Example);
+@abstractClass
+abstract class AbstractExample {}
+registerClass("RuntimeReflectionAbstract", AbstractExample);
+class ConcreteExample extends AbstractExample {}
+registerClass("RuntimeReflectionConcrete", ConcreteExample);
+
+xaravelTest("XT-runtime-152", "parameter metadata preserves nullable defaults and ordered attributes", () => {
+  let calls = 0;
+  const fn = inject({ value: optional(attributed(nullable(Example), parameterAttribute(ExampleAttribute, "first")), () => { calls++; return []; }), rest: variadic(String) }, (value: unknown, ...rest: unknown[]) => { void value; void rest; return null; });
+  const [param, rest] = new ReflectionFunction(fn).getParameters();
+  Assert.assertTrue(param!.isOptional());
+  Assert.assertTrue(param!.allowsNull());
+  Assert.assertTrue(param!.hasType());
+  Assert.assertSame(0, calls);
+  Assert.assertFalse(param!.getDefaultValue() === param!.getDefaultValue());
+  Assert.assertSame(2, calls);
+  Assert.assertSame("first", (param!.getAttributes()[0]!.newInstance() as ExampleAttribute).value);
+  Assert.assertTrue(rest!.isVariadic());
+  Assert.assertTrue(rest!.isOptional());
+  Assert.assertSame("value", new ReflectionParameter(fn, 0).getName());
+  Assert.assertTrue(new ReflectionParameter(fn, "value").allowsNull());
+  const union = new ReflectionFunction(inject({ x: nullable(oneOf(Example, String)) }, (x: unknown) => { void x; return null; })).getParameters()[0]!.getType();
+  Assert.assertTrue(union instanceof ReflectionUnionType);
+  Assert.assertTrue(union!.allowsNull());
+  Assert.assertNull(new ReflectionFunction(inject({ x: parameterAttribute(ExampleAttribute, "x") }, (x: unknown) => { void x; return null; })).getParameters()[0]!.getType());
+  for (const [fn, type] of [
+    [() => nullable(primitive), TypeError],
+    [() => attributed(optional(String, () => ""), parameterAttribute(ExampleAttribute)), TypeError],
+    [() => rest!.getDefaultValue(), ReflectionException],
+  ] as const) {
+    let error: unknown = null;
+    try { fn(); } catch (caught) { error = caught; }
+    Assert.assertTrue(error instanceof type);
+  }
+});
+
+xaravelTest("XT-runtime-153", "abstract classes, represented properties, callables and object identity reflect PHP behavior", () => {
+  Assert.assertFalse(new ReflectionClass(AbstractExample).isInstantiable());
+  Assert.assertTrue(new ReflectionClass(ConcreteExample).isInstantiable());
+  Assert.assertFalse(new ReflectionClass(ConcreteExample).isAbstract());
+  Assert.assertSame("__construct", new ReflectionClass(Example).getConstructor()!.getName());
+  const object = new Example("x");
+  Assert.assertSame(4, new ReflectionProperty(object, "value").getValue(object));
+  Assert.assertSame(spl_object_id(object), spl_object_id(object));
+  Assert.assertNotSame(spl_object_id(object), spl_object_id(new Example("y")));
+  Assert.assertSame(3, call_user_func((x: number) => x + 1, 2));
+});
