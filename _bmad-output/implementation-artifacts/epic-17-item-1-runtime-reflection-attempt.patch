--- /dev/null
+++ b/packages/runtime/src/php/ReflectionProperty.ts
@@ -0,0 +1,27 @@
+import { fqcn, registerClass } from "../registry/registry";
+import { ReflectionException } from "./ReflectionException";
+import { reflectionTarget, type ReflectionTarget } from "./reflectionTargets";
+
+/** Reflection over represented JavaScript properties. */
+export class ReflectionProperty {
+  readonly name: string;
+  readonly class: string;
+  readonly #target: ReflectionTarget;
+  constructor(objectOrClass: object | string, property: string) {
+    this.#target = reflectionTarget(objectOrClass, "ReflectionProperty::__construct(): Argument #1 ($class)");
+    this.name = property;
+    this.class = fqcn(this.#target);
+    if (typeof objectOrClass === "object" && objectOrClass !== null && typeof this.#target === "function" && !(property in objectOrClass) && !(property in this.#target)) {
+      throw new ReflectionException(`Property ${this.class}::$${property} does not exist`);
+    }
+  }
+  getName(): string { return this.name; }
+  getValue(object: unknown = null): unknown {
+    if (typeof this.#target !== "function" || (typeof object !== "object" && typeof object !== "function") || object === null || !Function.prototype[Symbol.hasInstance].call(this.#target, object)) {
+      throw new ReflectionException("Given object is not an instance of the class this property was declared in");
+    }
+    if (!(this.name in object)) throw new ReflectionException(`Property ${this.class}::$${this.name} does not exist`);
+    return (object as Record<string, unknown>)[this.name] ?? null;
+  }
+}
+registerClass("ReflectionProperty", ReflectionProperty);
