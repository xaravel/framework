diff --git a/packages/runtime/src/php/reflectionTypes.ts b/packages/runtime/src/php/reflectionTypes.ts
index 3c16f122..1eb86ce0 100644
--- a/packages/runtime/src/php/reflectionTypes.ts
+++ b/packages/runtime/src/php/reflectionTypes.ts
@@ -40,6 +40,12 @@ function namedType(spec: unknown, where: string): ReflectionNamedType {
  */
 export function typeOfSpec(spec: unknown, where: string): ReflectionTypeValue {
   const info = specOf(spec);
+  if (info?.kind === "nullable") {
+    const inner = typeOfSpec(info.spec, where);
+    if (inner instanceof ReflectionUnionType) return new ReflectionUnionType([...inner.getTypes(), new ReflectionNamedType("null", true)]);
+    if (inner instanceof ReflectionIntersectionType) return new ReflectionUnionType([inner, new ReflectionNamedType("null", true)]);
+    return new ReflectionNamedType(inner.getName(), inner.isBuiltin(), inner.getClassOrToken(), true);
+  }
   if (info?.kind === "oneOf") {
     return new ReflectionUnionType(info.types.map((member) => (specOf(member)?.kind === "allOf" ? intersectionOf(member, where) : namedType(member, where))));
   }
diff --git a/packages/runtime/src/php/spl_object_id.ts b/packages/runtime/src/php/spl_object_id.ts
new file mode 100644
index 00000000..001972e3
--- /dev/null
+++ b/packages/runtime/src/php/spl_object_id.ts
@@ -0,0 +1,12 @@
+import { isClassConstructor } from "./Closure";
+import { phpType, phpTypeName } from "./phpType";
+import { TypeError as PhpTypeError } from "./TypeError";
+import { objectId } from "./WeakMap";
+
+/** PHP's object identity, shared with WeakMap diagnostics. */
+export function spl_object_id(object: unknown): number {
+  if (object === null || (typeof object !== "object" && typeof object !== "function") || isClassConstructor(object) || phpType(object) !== "object") {
+    throw new PhpTypeError(`spl_object_id(): Argument #1 ($object) must be of type object, ${phpTypeName(object)} given`);
+  }
+  return objectId(object);
+}
