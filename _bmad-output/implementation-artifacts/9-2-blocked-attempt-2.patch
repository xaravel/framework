+          }
+          return "caught";
+        })(),
+      );
+      Assert.assertSame(1, (await wrapped.next()).value);
+      return { frame, wrapped };
+    });
+    Assert.assertNull(currentFrame());
+    const resumed = await paused.wrapped.throw(failure);
+    Assert.assertSame("caught", resumed.value);
