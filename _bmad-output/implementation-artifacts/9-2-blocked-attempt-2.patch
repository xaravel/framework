+    let classStream: ReadableStream<string> | null = null;
+
+    runInFrame("unit", () => {
+      creator = currentFrame();
+      timerDone = new Promise<void>((done) => {
+        setTimeout(
+          bindToFrame(() => {
+            seen["timer"] = currentFrame();
+            done();
+          }),
+          5,
+        );
+      });
+      const defaultSource = {
+        async pull(controller: ReadableStreamDefaultController<string>): Promise<void> {
+          await Bun.sleep(1);
