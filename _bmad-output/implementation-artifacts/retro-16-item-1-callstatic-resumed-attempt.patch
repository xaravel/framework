diff --git a/packages/json-schema/tests/xaravel/call-static.test.ts b/packages/json-schema/tests/xaravel/call-static.test.ts
new file mode 100644
index 00000000..20fe89c8
--- /dev/null
+++ b/packages/json-schema/tests/xaravel/call-static.test.ts
@@ -0,0 +1,129 @@
+// Xaravel Test for Epic 16 retrospective item 1 (finding S1). XT-json-schema-4: `JsonSchema.__callStatic(name, args)`
+// is Laravel's `JsonSchema::__callStatic`, `(new JsonSchemaTypeFactory)->$name(...$arguments)`, checked against
+// Upstream's own results on the host's PHP 8.5.11: `call-static.probe.php` runs Upstream's illuminate/json-schema at
+// the Pin over the calls of `CASES`, and `call-static.probe.txt` is its record (`<label>\t<class>\t<json toArray>`, or
+// `<label>\t!<class>: <message>`; how to regenerate it is in the probe's header). For each case the port's result
+// class (`fqcn`) and `toArray()`, or its thrown class and message, equal the record; each builder case also equals the
+// static builder `JsonSchema.<name>(...args)`. An unknown name throws PHP's `Error` before `args` is read, and an
+// `args` that is no array or Traversable PHP's `TypeError`, as PHP does. A string-keyed `args` is a named-argument
+// spread, which stays untranslatable (DIV-9.15, ESC-14.5-3): the port throws a JS `TypeError` naming it, asserted
+// beside the record's PHP result.
+import { readFileSync } from "node:fs";
+import { join } from "node:path";
+import { Assert, xaravelTest } from "@xaravel/assert";
+import { ArrayIterator, fqcn, jsonEncode, PhpArray } from "@xaravel/runtime";
+import { JsonSchema, type Type } from "../../src";
+
+/** `callUnpacked`'s diagnostic for a string-keyed spread into a target without an options form (ESC-14.5-3). */
+const UNTRANSLATABLE = "callUnpacked(): named argument unpacking is untranslatable for a target without an options form (ESC-14.5-3)";
+
+/** A case: its label, the name, a builder of fresh arguments, and a call of the static builder it must equal (or null). */
+type Case = readonly [label: string, name: string, args: () => unknown, builder: ((args: unknown[]) => Type) | null];
+
+/** The calls of `call-static.probe.php`, in its order, built as it builds them. */
+const CASES: readonly Case[] = [
+  ["object-properties", "object", () => [{ name: JsonSchema.string().required(), age: JsonSchema.integer().min(0) }], (a) => JsonSchema.object(a[0] as Parameters<typeof JsonSchema.object>[0])],
+  ["object-none", "object", () => [], () => JsonSchema.object()],
+  ["any-of", "anyOf", () => [[JsonSchema.string(), JsonSchema.integer()]], (a) => JsonSchema.anyOf(a[0] as Parameters<typeof JsonSchema.anyOf>[0])],
+  ["integer", "integer", () => [], () => JsonSchema.integer()],
+  ["number", "number", () => [], () => JsonSchema.number()],
+  ["string", "string", () => [], () => JsonSchema.string()],
+  ["boolean", "boolean", () => [], () => JsonSchema.boolean()],
+  ["array", "array", () => [], () => JsonSchema.array()],
+  ["union", "union", () => [["string", "null"]], (a) => JsonSchema.union(a[0] as Parameters<typeof JsonSchema.union>[0])],
+  ["case-insensitive", "String", () => [], null],
+  ["extra-positional", "integer", () => [1, 2], null],
+  ["int-keyed-non-list", "string", () => new PhpArray<number, string>([[1, "x"]]), null],
+  ["traversable", "string", () => new ArrayIterator(new PhpArray([[1, "x"]])), null],
+  // PHP normalizes the numeric string key to int; the runtime also accepts this plain-object representation.
+  ["numeric-object", "string", () => ({ 0: "x" }), null],
+  // object() consumes the unpacked properties, so dropping values or sorting integer keys changes the record.
+  ["object-int-keyed-non-list", "object", () => new PhpArray([[1, { name: JsonSchema.string() }]]), null],
+  ["object-traversable", "object", () => new ArrayIterator(new PhpArray([[1, { name: JsonSchema.string() }]])), null],
+  ["object-numeric-object", "object", () => ({ 0: { name: JsonSchema.string() } }), null],
+  ["object-out-of-order-int-keys", "object", () => new PhpArray<number, unknown>([[7, { name: JsonSchema.string() }], [2, { ignored: JsonSchema.integer() }]]), null],
+  ["mixed-positional-named", "string", () => new PhpArray<number | string, unknown>([[0, "x"], ["a", 1]]), null],
+  ["static-on-factory", "fromArray", () => [{ type: "string" }], null],
+  ["unknown-name", "foo", () => [], null],
+  ["unknown-to-array", "toArray", () => [], null],
+  ["unknown-empty-name", "", () => [], null],
+  ["unknown-name-non-array-args", "foo", () => 1, null],
+  ["non-array-int", "string", () => 1, null],
+  ["non-array-null", "string", () => null, null],
+  ["non-array-string", "string", () => "x", null],
+  ["string-keyed-unknown", "string", () => ({ a: 1 }), null],
+  ["string-keyed-properties", "object", () => ({ properties: { name: JsonSchema.string() } }), null],
+];
+
+/** The string-keyed cases: a named-argument spread, untranslatable in the port (DIV-9.15). */
+const STRING_KEYED = new Map<string, string>([
+  ["string-keyed-unknown", "!Error: Unknown named parameter $a"],
+  ["string-keyed-properties", 'Illuminate\\JsonSchema\\Types\\ObjectType\t{"properties":{"name":{"type":"string"}},"type":"object"}'],
+  ["mixed-positional-named", "!Error: Unknown named parameter $a"],
+]);
+
+/** `value` encoded by `jsonEncode`, PHP's `json_encode` with no flags; throws when it cannot be encoded. */
+function json(value: unknown): string {
+  const encoded = jsonEncode(value);
+  if (encoded === false) {
+    throw new globalThis.Error("jsonEncode failed");
+  }
+  return encoded;
+}
+
+/** A Type as the probe records it: `<class>\t<json toArray>`. */
+function recorded(type: Type): string {
+  return `${fqcn(type)}\t${json(type.toArray())}`;
+}
+
+/** The error `fn` throws, or `null` when it returns. */
+function thrownBy(fn: () => unknown): unknown {
+  try {
+    fn();
+  } catch (error) {
+    return error;
+  }
+  return null;
+}
+
+/** Each label's recorded result, in the probe's order. */
+const evidence: [string, string][] = readFileSync(join(import.meta.dir, "call-static.probe.txt"), "utf8").trim().split("\n").map((line) => {
+  const tab = line.indexOf("\t");
+  return [line.slice(0, tab), line.slice(tab + 1)];
+});
+
+xaravelTest(
+  "XT-json-schema-4",
+  "JsonSchema.__callStatic(name, args) is Laravel's (new JsonSchemaTypeFactory)->$name(...$arguments), against Upstream's results recorded on PHP 8.5.11 (call-static.probe.txt), the record's labels equal to the test's both ways: each builder (object with properties and without, anyOf, integer, number, string, boolean, array, union) gives Upstream's Type class and toArray() and equals JsonSchema.<name>(...args); a name in another case, extra positional arguments, an integer-keyed PhpArray that is not a list, a Traversable, a numeric-key plain object and a static method of the factory (fromArray) give Upstream's Type; object(properties) preserves properties unpacked from each representation and insertion order for out-of-order integer keys; an unknown name (foo, toArray, the empty name, foo with args 1) throws PHP's Error Call to undefined method Illuminate\\JsonSchema\\JsonSchemaTypeFactory::<name>() before args is read; args that are no array or Traversable (1, null, \"x\") throw PHP's TypeError Only arrays and Traversables can be unpacked, <type> given; and a string-keyed args (including positional-then-named keys), a named-argument spread PHP accepts or rejects by parameter name, throws callUnpacked's untranslatable TypeError (DIV-9.15, ESC-14.5-3)",
+  () => {
+    Assert.assertSame(CASES.map(([label]) => label), evidence.map(([label]) => label), "call-static.probe.txt records exactly the test's cases, in order (regenerate it as call-static.probe.php's header says)");
+    const record = new Map(evidence);
+
+    for (const [label, name, args, builder] of CASES) {
+      const expected = record.get(label)!;
+      if (STRING_KEYED.has(label)) {
+        // PHP binds a string key as a named argument: `$a` is unknown to `string()` (Error), `$properties` binds
+        // `object()`'s parameter (an ObjectType). The port cannot bind a JS parameter by name, so the spread throws.
+        Assert.assertSame(STRING_KEYED.get(label), expected, `${label}: the record shows PHP's exact result`);
+        const thrown = thrownBy(() => JsonSchema.__callStatic(name, args()));
+        Assert.assertInstanceOf(globalThis.TypeError, thrown, `${label}: a string-keyed args throws TypeError`); // adapted:DIV-9.15
+        Assert.assertSame(UNTRANSLATABLE, (thrown as Error).message, `${label}: naming the untranslatable named-argument spread`); // adapted:DIV-9.15
+        continue;
+      }
+      let actual: string;
+      try {
+        actual = recorded(JsonSchema.__callStatic(name, args()));
+      } catch (thrown) {
+        if (!(thrown instanceof globalThis.Error)) {
+          throw thrown;
+        }
+        actual = `!${fqcn(thrown)}: ${thrown.message}`;
+      }
+      Assert.assertSame(expected, actual, `${label}: __callStatic("${name}", …) gives Upstream's result`);
+      if (builder !== null) {
+        const direct = builder(args() as unknown[]);
+        Assert.assertSame(recorded(direct), actual, `${label}: __callStatic equals JsonSchema.${name}(...args)`);
+      }
+    }
+  },
+);
diff --git a/packages/json-schema/tests/xaravel/ref-utf8.probe.php b/packages/json-schema/tests/xaravel/ref-utf8.probe.php
new file mode 100644
index 00000000..86b5aeb1
--- /dev/null
+++ b/packages/json-schema/tests/xaravel/ref-utf8.probe.php
@@ -0,0 +1,37 @@
+<?php
+// The PHP evidence for XT-json-schema-5 (ref-utf8.test.ts, `CASES`): Upstream's illuminate/json-schema at the Pin
+// (conformance/upstream/framework/src/Illuminate/JsonSchema), loaded as it is, deserializes a schema whose local `$ref`
+// has a percent-escape. `Deserializer::lookupRef` `rawurldecode`s each pointer segment: `%FF` decodes to a byte that
+// is not UTF-8, `%C3` to a truncated UTF-8 sequence, `%C3%A9` to `é`. Each line is `<label>\t<json_encode($type->toArray())>`, or `<label>\t!<class>:
+// <message>` when PHP throws. The test builds the same schemas, in the same order, and compares. Regenerate the record
+// with the host's PHP 8.5, from this directory:
+//   php -d error_reporting=0 ref-utf8.probe.php > ref-utf8.probe.txt
+
+$src = __DIR__.'/../../../../conformance/upstream/framework/src/Illuminate';
+
+spl_autoload_register(function (string $class) use ($src) {
+    foreach (['Illuminate\\JsonSchema\\' => '/JsonSchema/', 'Illuminate\\Contracts\\' => '/Contracts/'] as $prefix => $dir) {
+        if (str_starts_with($class, $prefix)) {
+            require $src.$dir.str_replace('\\', '/', substr($class, strlen($prefix))).'.php';
+
+            return;
+        }
+    }
+});
+
+use Illuminate\JsonSchema\JsonSchema;
+
+$cases = [
+    'ref-non-utf8' => ['$ref' => '#/d/a%FF', 'd' => ['a' => ['type' => 'string']]],
+    'ref-truncated-utf8' => ['$ref' => '#/d/a%C3', 'd' => ['a' => ['type' => 'string']]],
+    'ref-utf8-control' => ['$ref' => '#/d/a%C3%A9', 'd' => ["a\u{e9}" => ['type' => 'string']]],
+];
+
+foreach ($cases as $label => $schema) {
+    try {
+        $value = json_encode(JsonSchema::fromArray($schema)->toArray());
+        echo $label, "\t", $value, "\n";
+    } catch (Throwable $e) {
+        echo $label, "\t!", get_class($e), ': ', $e->getMessage(), "\n";
+    }
+}
