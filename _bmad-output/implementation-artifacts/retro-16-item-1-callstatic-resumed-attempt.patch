diff --git a/packages/json-schema/tests/xaravel/ref-utf8.test.ts b/packages/json-schema/tests/xaravel/ref-utf8.test.ts
new file mode 100644
index 00000000..c5ad02c1
--- /dev/null
+++ b/packages/json-schema/tests/xaravel/ref-utf8.test.ts
@@ -0,0 +1,58 @@
+// Xaravel Test for Epic 16 retrospective item 1 (finding D1). XT-json-schema-5: the runtime holds a PHP string as a JS
+// string, so it cannot hold bytes that are not valid UTF-8 (DIV-9.18). `Deserializer::lookupRef` `rawurldecode`s each
+// JSON-pointer segment of a local `$ref`; where the decoded bytes are not UTF-8 (`%FF` or truncated `%C3`), Upstream finds no such key and
+// throws `InvalidArgumentException`, and the port's `rawurldecode` throws a JS `TypeError` naming the limit, never a
+// silently different value. A control beside it (`%C3%A9`, `é`) resolves as in PHP. `ref-utf8.probe.php` runs
+// Upstream's illuminate/json-schema at the Pin over these schemas on the host's PHP 8.5.11, and `ref-utf8.probe.txt`
+// is its record (`<label>\t<json toArray>` or `<label>\t!<class>: <message>`; how to regenerate it is in the probe's
+// header).
+import { readFileSync } from "node:fs";
+import { join } from "node:path";
+import { Assert, xaravelTest } from "@xaravel/assert";
+import { jsonEncode } from "@xaravel/runtime";
+import { JsonSchema } from "../../src";
+
+const RAWURLDECODE_LIMIT = "rawurldecode(): the result splits a UTF-8 sequence, which JS cannot hold";
+
+/** The schemas of `ref-utf8.probe.php`, in its order. */
+const CASES: readonly (readonly [string, () => Record<string, unknown>])[] = [
+  ["ref-non-utf8", () => ({ $ref: "#/d/a%FF", d: { a: { type: "string" } } })],
+  ["ref-truncated-utf8", () => ({ $ref: "#/d/a%C3", d: { a: { type: "string" } } })],
+  ["ref-utf8-control", () => ({ $ref: "#/d/a%C3%A9", d: { "aé": { type: "string" } } })],
+];
+
+/** The error `fn` throws, or `null` when it returns. */
+function thrownBy(fn: () => unknown): unknown {
+  try {
+    fn();
+  } catch (error) {
+    return error;
+  }
+  return null;
+}
+
+/** Each label's recorded result, in the probe's order. */
+const evidence: [string, string][] = readFileSync(join(import.meta.dir, "ref-utf8.probe.txt"), "utf8").trim().split("\n").map((line) => {
+  const tab = line.indexOf("\t");
+  return [line.slice(0, tab), line.slice(tab + 1)];
+});
+
+xaravelTest(
+  "XT-json-schema-5",
+  "a local $ref whose percent-escape decodes to bytes that are not UTF-8 (#/d/a%FF or truncated #/d/a%C3) throws a TypeError naming rawurldecode()'s UTF-8 limit where Upstream on PHP 8.5.11 throws InvalidArgumentException Unable to resolve JSON Schema $ref [#/d/a%FF]. (DIV-9.18), while the valid UTF-8 control #/d/a%C3%A9 resolves the key aé to Upstream's {\"type\":\"string\"}; the record's labels equal the test's both ways",
+  () => {
+    Assert.assertSame(CASES.map(([label]) => label), evidence.map(([label]) => label), "ref-utf8.probe.txt records exactly the test's cases, in order (regenerate it as ref-utf8.probe.php's header says)");
+    const record = new Map(evidence);
+    const control = CASES[2]!;
+    for (const [label, schema] of CASES.slice(0, 2)) {
+      // PHP retains the invalid bytes, which match no key in this schema's `d`.
+      Assert.assertSame(`!InvalidArgumentException: Unable to resolve JSON Schema $ref [${schema()["$ref"] as string}].`, record.get(label), "the record shows PHP's InvalidArgumentException");
+      const thrown = thrownBy(() => JsonSchema.fromArray(schema()));
+      Assert.assertInstanceOf(TypeError, thrown, "a $ref segment decoding to non-UTF-8 bytes throws TypeError"); // adapted:DIV-9.18
+      Assert.assertSame(RAWURLDECODE_LIMIT, (thrown as Error).message, "naming rawurldecode()'s UTF-8 limit"); // adapted:DIV-9.18
+    }
+
+    // Control: the same pointer with a valid UTF-8 escape resolves as in PHP.
+    Assert.assertSame(record.get(control[0]), jsonEncode(JsonSchema.fromArray(control[1]()).toArray()), "a $ref segment decoding to valid UTF-8 resolves as in PHP");
+  },
+);
