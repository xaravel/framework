diff --git a/packages/json-schema/tests/xaravel/call-static.probe.php b/packages/json-schema/tests/xaravel/call-static.probe.php
new file mode 100644
index 00000000..4118889c
--- /dev/null
+++ b/packages/json-schema/tests/xaravel/call-static.probe.php
@@ -0,0 +1,71 @@
+<?php
+// The PHP evidence for XT-json-schema-4 (call-static.test.ts, `CASES`): Upstream's illuminate/json-schema at the Pin
+// (conformance/upstream/framework/src/Illuminate/JsonSchema), loaded as it is, calls `JsonSchema::__callStatic($name,
+// $arguments)`, which is `(new JsonSchemaTypeFactory)->$name(...$arguments)`, for each case below. Each line is
+// `<label>\t<class>\t<json_encode($type->toArray())>`, or `<label>\t!<class>: <message>` when PHP throws. The test
+// builds the same calls, in the same order, and compares. Regenerate the record with the host's PHP 8.5, from this
+// directory:
+//   php -d error_reporting=0 call-static.probe.php > call-static.probe.txt
+
+$src = __DIR__.'/../../../../conformance/upstream/framework/src/Illuminate';
+
+spl_autoload_register(function (string $class) use ($src) {
+    foreach (['Illuminate\\JsonSchema\\' => '/JsonSchema/', 'Illuminate\\Contracts\\' => '/Contracts/'] as $prefix => $dir) {
+        if (str_starts_with($class, $prefix)) {
+            require $src.$dir.str_replace('\\', '/', substr($class, strlen($prefix))).'.php';
+
+            return;
+        }
+    }
+});
+
+use Illuminate\JsonSchema\JsonSchema;
+
+$cases = [
+    // Each builder, with a list of arguments.
+    'object-properties' => ['object', [['name' => JsonSchema::string()->required(), 'age' => JsonSchema::integer()->min(0)]]],
+    'object-none' => ['object', []],
+    'any-of' => ['anyOf', [[JsonSchema::string(), JsonSchema::integer()]]],
+    'integer' => ['integer', []],
+    'number' => ['number', []],
+    'string' => ['string', []],
+    'boolean' => ['boolean', []],
+    'array' => ['array', []],
+    'union' => ['union', [['string', 'null']]],
+    // PHP's method names are case-insensitive; extra positional arguments are ignored by a userland method.
+    'case-insensitive' => ['String', []],
+    'extra-positional' => ['integer', [1, 2]],
+    // An integer-keyed array that is not a list spreads positionally.
+    'int-keyed-non-list' => ['string', [1 => 'x']],
+    'traversable' => ['string', new ArrayIterator([1 => 'x'])],
+    'numeric-object' => ['string', ['0' => 'x']],
+    // The first argument's properties must survive unpacking, in insertion order rather than key order.
+    'object-int-keyed-non-list' => ['object', [1 => ['name' => JsonSchema::string()]]],
+    'object-traversable' => ['object', new ArrayIterator([1 => ['name' => JsonSchema::string()]])],
+    'object-numeric-object' => ['object', ['0' => ['name' => JsonSchema::string()]]],
+    'object-out-of-order-int-keys' => ['object', [7 => ['name' => JsonSchema::string()], 2 => ['ignored' => JsonSchema::integer()]]],
+    'mixed-positional-named' => ['string', [0 => 'x', 'a' => 1]],
+    // A static method of the factory (inherited from JsonSchema).
+    'static-on-factory' => ['fromArray', [['type' => 'string']]],
+    // An unknown name throws before the arguments are unpacked.
+    'unknown-name' => ['foo', []],
+    'unknown-to-array' => ['toArray', []],
+    'unknown-empty-name' => ['', []],
+    'unknown-name-non-array-args' => ['foo', 1],
+    // Arguments that are no array or Traversable.
+    'non-array-int' => ['string', 1],
+    'non-array-null' => ['string', null],
+    'non-array-string' => ['string', 'x'],
+    // String keys are named arguments.
+    'string-keyed-unknown' => ['string', ['a' => 1]],
+    'string-keyed-properties' => ['object', ['properties' => ['name' => JsonSchema::string()]]],
+];
+
+foreach ($cases as $label => [$name, $arguments]) {
+    try {
+        $type = JsonSchema::__callStatic($name, $arguments);
+        echo $label, "\t", get_class($type), "\t", json_encode($type->toArray()), "\n";
+    } catch (Throwable $e) {
+        echo $label, "\t!", get_class($e), ': ', $e->getMessage(), "\n";
+    }
+}
