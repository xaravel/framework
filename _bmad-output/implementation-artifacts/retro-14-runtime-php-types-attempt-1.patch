diff --git a/packages/runtime/src/php/liveCursor.ts b/packages/runtime/src/php/liveCursor.ts
new file mode 100644
index 00000000..9147f286
--- /dev/null
+++ b/packages/runtime/src/php/liveCursor.ts
@@ -0,0 +1,121 @@
+// A position over a live insertion-ordered collection (a `Map` or `Set` iterator), as PHP's hash iteration keeps one
+// (ESC-14.1-2). Internal: `ArrayIterator` and `WeakMap`'s `InternalIterator` share it. A JS `Map` / `Set` iterator
+// sees entries added after it was made and skips deleted ones, as PHP's position does, until it reports done; a
+// cursor at the end therefore re-reads the collection from its last entry, so an entry appended later is still
+// reached (`$it->next(); $a[] = 2; $it->valid()` is true, as in PHP). When that last entry has been deleted the cursor
+// stays at the end. A cursor starts unpositioned and rewinds on its first read, as PHP's starts at the first entry.
+// It is registered under a Xaravel name, as `PhpArray` is (AD-10).
+import { registerClass } from "../registry/registry";
+
+/** The position of a PHP iterator over a live collection whose items are `T`. */
+export class LiveCursor<T> {
+  readonly #source: () => globalThis.Iterator<T>;
+  readonly #alive: (item: T) => boolean;
+  #iterator: globalThis.Iterator<T> | null = null;
+  #current: { readonly item: T } | null = null;
+  /** The last item the cursor stood on, which an end-of-collection re-read resumes after. */
+  #last: { readonly item: T } | null = null;
+
+  /** `source()` gives a fresh live iterator; `alive(item)` says whether `item` is still in the collection. */
+  constructor(source: () => globalThis.Iterator<T>, alive: (item: T) => boolean) {
+    this.#source = source;
+    this.#alive = alive;
+  }
+
+  /** Moves to the first item. */
+  rewind(): void {
+    this.#iterator = this.#source();
+    this.#last = null;
+    this.#fetch();
+  }
+
+  /** The item the cursor stands on, or null past the end. */
+  item(): { readonly item: T } | null {
+    this.#sync();
+    return this.#current;
+  }
+
+  /** Moves to the next item; a no-op past the end. */
+  next(): void {
+    this.#sync();
+    if (this.#current !== null) {
+      this.#fetch();
+    }
+  }
+
+  #fetch(): void {
+    const iterator = this.#iterator as globalThis.Iterator<T>;
+    for (;;) {
+      const step = iterator.next();
+      if (step.done === true) {
+        this.#current = null;
+        return;
+      }
+      if (this.#alive(step.value)) {
+        this.#current = { item: step.value };
+        this.#last = this.#current;
+        return;
+      }
+    }
+  }
+
+  /** Rewinds an unpositioned cursor, steps off a deleted item, and re-reads past the end for appended items. */
+  #sync(): void {
+    if (this.#iterator === null) {
+      this.rewind();
+      return;
+    }
+    if (this.#current !== null) {
+      if (!this.#alive(this.#current.item)) {
+        this.#fetch();
+      }
+      return;
+    }
+    const last = this.#last;
+    const iterator = this.#source();
+    if (last !== null) {
+      if (!this.#alive(last.item)) {
+        return;
+      }
+      for (;;) {
+        const step = iterator.next();
+        if (step.done === true) {
+          return;
+        }
+        if (Object.is(step.value, last.item)) {
+          break;
+        }
+      }
+    }
+    this.#iterator = iterator;
+    this.#fetch();
+    if (this.#current === null) {
+      this.#last = last;
+    }
+  }
+}
+
+/** The five methods of PHP's `Iterator`, as `foreachIterator` calls them. */
+interface IteratorMethods {
+  rewind(): void;
+  valid(): boolean;
+  current(): unknown;
+  key(): unknown;
+  next(): void;
+}
+
+/**
+ * PHP's `foreach` over an `Iterator`: `rewind()`, then while `valid()`, `current()` and `key()` as one
+ * `[key, value]` pair, then `next()`. The `[Symbol.iterator]()` of the runtime's Iterator classes.
+ */
+export function* foreachIterator(iterator: IteratorMethods): Generator<[unknown, unknown], void, undefined> {
+  iterator.rewind();
+  while (iterator.valid()) {
+    const value = iterator.current();
+    const key = iterator.key();
+    yield [key, value];
+    iterator.next();
+  }
+}
+
+registerClass("Xaravel\\Runtime\\Php\\LiveCursor", LiveCursor);
diff --git a/packages/runtime/src/php/phpInterface.ts b/packages/runtime/src/php/phpInterface.ts
new file mode 100644
index 00000000..7b216e72
--- /dev/null
+++ b/packages/runtime/src/php/phpInterface.ts
@@ -0,0 +1,51 @@
+// PHP's built-in interfaces as contract tokens (ESC-14.1-2, action item epic-14-item-1-runtime-php-types). Internal.
+// `phpInterface(name, members, parents, builtins)` builds the frozen token `@xaravel/contracts`' `contract()` builds
+// for the same arguments, with the same own keys, in the same order and with the same descriptors (XT-contracts-22
+// pins the two equal): `CONTRACT_BUILTINS` when not empty, `brand` (`Symbol.for(name)`), the FQCN key, the method
+// names, their parameter lists, the parents, and the `Symbol.hasInstance` / `Symbol.toPrimitive` methods. It copies
+// the shape rather than sharing it, because the runtime never imports `@xaravel/contracts` (AD-2). The token is
+// recorded with `registerContractToken`, so the class lookup, `interfaceExists` and reflection resolve its PHP name.
+// The arguments are the runtime's own constants, so nothing is validated here.
+import { registerContractToken } from "../registry/registry";
+
+const CLASS_FQCN = Symbol.for("xaravel.class.fqcn");
+const CONTRACT_METHODS = Symbol.for("xaravel.contract.methods");
+const CONTRACT_PARAMETERS = Symbol.for("xaravel.contract.parameters");
+const CONTRACT_PARENTS = Symbol.for("xaravel.contract.parents");
+const CONTRACT_BUILTINS = Symbol.for("xaravel.contract.builtins");
+
+/** A PHP built-in interface's token: `x instanceof Token` reads the brand, and `Token.brand` is the brand key. */
+export type PhpInterfaceToken<T extends object, B extends symbol> = {
+  readonly brand: B;
+  [Symbol.hasInstance](value: unknown): value is T;
+  [Symbol.toPrimitive](hint: string): B;
+};
+
+/** Builds and records the token of the PHP interface `name` (see the header). */
+export function phpInterface<T extends object, B extends symbol>(
+  name: string,
+  members: Readonly<Record<string, readonly string[]>> = {},
+  parents: readonly object[] = [],
+  builtins: readonly string[] = [],
+): PhpInterfaceToken<T, B> {
+  const parameters = Object.freeze(Object.fromEntries(Object.entries(members).map(([method, list]) => [method, Object.freeze([...list])])));
+  const builtinMethods = Object.freeze([...builtins]);
+  const brand = Symbol.for(name);
+  const token = {
+    ...(builtinMethods.length > 0 ? { [CONTRACT_BUILTINS]: builtinMethods } : {}),
+    brand,
+    [CLASS_FQCN]: name,
+    [CONTRACT_METHODS]: Object.freeze(Object.keys(parameters)),
+    [CONTRACT_PARAMETERS]: parameters,
+    [CONTRACT_PARENTS]: Object.freeze([...parents]),
+    [Symbol.hasInstance](value: unknown): boolean {
+      return ((typeof value === "object" && value !== null) || typeof value === "function") && (value as Record<symbol, unknown>)[brand] === true;
+    },
+    [Symbol.toPrimitive](): symbol {
+      return brand;
+    },
+  };
+  const frozen = Object.freeze(token);
+  registerContractToken(frozen);
+  return frozen as unknown as PhpInterfaceToken<T, B>;
+}
