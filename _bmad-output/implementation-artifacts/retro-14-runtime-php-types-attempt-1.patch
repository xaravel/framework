diff --git a/packages/runtime/src/php/ArrayIterator.ts b/packages/runtime/src/php/ArrayIterator.ts
new file mode 100644
index 00000000..d827a284
--- /dev/null
+++ b/packages/runtime/src/php/ArrayIterator.ts
@@ -0,0 +1,141 @@
+// PHP's `ArrayIterator` (ESC-14.1-2): an `Iterator` over a PHP array held as a `PhpArray`, also the iterator an
+// `ArrayObject`'s `getIterator()` returns over the same storage (`arrayStorage.ts`). Its position is live
+// (`LiveCursor`): it sees entries written after it was made, as PHP's hash position does. A missing key reads as
+// null (PHP's warning is not reproduced). `ARRAY_AS_PROPS` and `STD_PROP_LIST` are kept by `getFlags()` /
+// `setFlags()` but not acted on; `seek()` and the sort methods are not ported. It carries the `Iterator` and
+// `Traversable` brands, `[Symbol.iterator]()` runs PHP's `foreach` protocol, and its props (`json_encode`, `==`) are its
+// storage, as PHP's `get_properties` handler gives them.
+import { registerClass } from "../registry/registry";
+import { arrayFromEntries, type PhpArrayKey, type PhpKeyInput } from "./PhpArray";
+import { type ArrayState, initState, serializeState, stateOf, unserializeState } from "./arrayStorage";
+import { Iterator } from "./Iterator";
+import { foreachIterator, LiveCursor } from "./liveCursor";
+import { Traversable } from "./Traversable";
+
+const PHP_PROPS = Symbol.for("xaravel.php.props");
+
+/** The state of `it` with its position made. */
+function positioned(it: ArrayIterator): ArrayState & { cursor: LiveCursor<PhpArrayKey> } {
+  const state = stateOf(it);
+  if (state.cursor === null) {
+    state.cursor = new LiveCursor<PhpArrayKey>(
+      () => state.box.array.keys(),
+      (key) => state.box.array.has(key),
+    );
+  }
+  return state as ArrayState & { cursor: LiveCursor<PhpArrayKey> };
+}
+
+export class ArrayIterator implements Iterator {
+  /** PHP's `ArrayIterator::STD_PROP_LIST`. */
+  static readonly STD_PROP_LIST = 1;
+  /** PHP's `ArrayIterator::ARRAY_AS_PROPS`. */
+  static readonly ARRAY_AS_PROPS = 2;
+
+  /**
+   * `new ArrayIterator($array = [], $flags = 0)`: a copy of a PHP array, or the storage of an `ArrayObject` or
+   * `ArrayIterator` (shared), or a copy of another object's properties. Throws PHP's `TypeError` for any other value.
+   */
+  constructor(array: unknown = [], flags: number = 0) {
+    initState(this, "ArrayIterator", array, flags);
+  }
+
+  get [Iterator.brand](): true {
+    return true;
+  }
+
+  get [Traversable.brand](): true {
+    return true;
+  }
+
+  /** The value at the position, or null past the end. */
+  current(): unknown {
+    const state = positioned(this);
+    const item = state.cursor.item();
+    return item === null ? null : state.box.array.get(item.item);
+  }
+
+  /** The key at the position, or null past the end. */
+  key(): PhpArrayKey | null {
+    return positioned(this).cursor.item()?.item ?? null;
+  }
+
+  next(): void {
+    positioned(this).cursor.next();
+  }
+
+  rewind(): void {
+    positioned(this).cursor.rewind();
+  }
+
+  valid(): boolean {
+    return positioned(this).cursor.item() !== null;
+  }
+
+  /** `count($it)`. */
+  count(): number {
+    return stateOf(this).box.array.size;
+  }
+
+  /** A copy of the storage, as AD-9 holds a PHP array. */
+  getArrayCopy(): unknown {
+    return arrayFromEntries(stateOf(this).box.array);
+  }
+
+  /** `array_key_exists`: true for a key whose value is null. */
+  offsetExists(key: PhpKeyInput): boolean {
+    return stateOf(this).box.array.has(key);
+  }
+
+  /** The value at `key`, or null when it is missing. */
+  offsetGet(key: PhpKeyInput): unknown {
+    return stateOf(this).box.array.get(key);
+  }
+
+  /** `$it[$key] = $value`; a null key appends, as `$it[] = $value`. */
+  offsetSet(key: PhpKeyInput, value: unknown): void {
+    const array = stateOf(this).box.array;
+    if (key === null) {
+      array.push(value);
+    } else {
+      array.set(key, value);
+    }
+  }
+
+  offsetUnset(key: PhpKeyInput): void {
+    stateOf(this).box.array.delete(key);
+  }
+
+  /** `$it[] = $value`. */
+  append(value: unknown): void {
+    stateOf(this).box.array.push(value);
+  }
+
+  getFlags(): number {
+    return stateOf(this).flags;
+  }
+
+  setFlags(flags: number): void {
+    stateOf(this).flags = flags;
+  }
+
+  /** `[flags, storage, dynamic properties, null]`, PHP's serialized form. */
+  __serialize(): unknown[] {
+    return serializeState(this);
+  }
+
+  __unserialize(data: unknown): void {
+    unserializeState(this, data);
+  }
+
+  /** The props protocol: the storage. */
+  [PHP_PROPS](): unknown {
+    return stateOf(this).box.array;
+  }
+
+  [Symbol.iterator](): Generator<[unknown, unknown], void, undefined> {
+    return foreachIterator(this);
+  }
+}
+
+registerClass("ArrayIterator", ArrayIterator);
