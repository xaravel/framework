diff --git a/packages/runtime/src/php/WeakMap.ts b/packages/runtime/src/php/WeakMap.ts
new file mode 100644
index 00000000..bccb0073
--- /dev/null
+++ b/packages/runtime/src/php/WeakMap.ts
@@ -0,0 +1,147 @@
+// PHP's `WeakMap` (ESC-14.1-2): a map from objects to values that holds its keys weakly and, unlike a JS `WeakMap`,
+// iterates, in insertion order (a rewritten key keeps its position). Each entry holds its key in a `WeakRef`; a
+// `FinalizationRegistry` drops an entry once its key is collected, and an entry whose key is gone is skipped before
+// that. A key is a PHP object (a class instance or a function, never a PHP array). `offsetExists` is `isset`: false for
+// a null value, as PHP's is. `getIterator()` is an `InternalIterator` over the live entries. It carries the
+// `IteratorAggregate` and `Traversable` brands; `[Symbol.iterator]()` yields `[key, value]` pairs. `phpSerialize`
+// throws PHP's `Exception` `Serialization of 'WeakMap' is not allowed`, as PHP does. The object ids in the missing-key
+// message (`Object stdClass#<n> not contained in WeakMap`) come from a runtime-local counter, as the grader's handles
+// do, so they are not PHP's numbers.
+import { registerClass } from "../registry/registry";
+import { Error as PhpError } from "./Error";
+import { Exception } from "./Exception";
+import { internalIterator, type InternalIterator } from "./InternalIterator";
+import { IteratorAggregate } from "./IteratorAggregate";
+import { LiveCursor } from "./liveCursor";
+import { getDebugType, phpType } from "./phpType";
+import { Traversable } from "./Traversable";
+import { TypeError as PhpTypeError } from "./TypeError";
+
+/** One entry: its key, held weakly, and its value. */
+interface Entry {
+  readonly ref: WeakRef<object>;
+  value: unknown;
+}
+
+/** The ids the missing-key message gives objects, by first use. */
+const objectIds = new globalThis.WeakMap<object, number>();
+let lastObjectId = 0;
+
+function objectId(o: object): number {
+  let id = objectIds.get(o);
+  if (id === undefined) {
+    id = ++lastObjectId;
+    objectIds.set(o, id);
+  }
+  return id;
+}
+
+/** `key` as a WeakMap key; throws PHP's `TypeError` when it is no PHP object. */
+function objectKey(key: unknown): object {
+  if (((typeof key === "object" && key !== null) || typeof key === "function") && phpType(key) === "object") {
+    return key;
+  }
+  throw new PhpTypeError("WeakMap key must be an object");
+}
+
+export class WeakMap implements IteratorAggregate {
+  readonly #byKey = new globalThis.WeakMap<object, Entry>();
+  /** The entries, in insertion order. */
+  readonly #order = new Set<Entry>();
+  readonly #registry = new FinalizationRegistry<Entry>((entry) => {
+    this.#order.delete(entry);
+  });
+
+  get [IteratorAggregate.brand](): true {
+    return true;
+  }
+
+  get [Traversable.brand](): true {
+    return true;
+  }
+
+  /** `$map[$key]`. Throws PHP's `Error` when `key` is not in the map. */
+  offsetGet(key: object): unknown {
+    const object = objectKey(key);
+    const entry = this.#byKey.get(object);
+    if (entry === undefined) {
+      throw new PhpError(`Object ${getDebugType(object)}#${objectId(object)} not contained in WeakMap`);
+    }
+    return entry.value;
+  }
+
+  /** `$map[$key] = $value`; a rewritten key keeps its position. A null key is `$map[] = $value`, which PHP refuses. */
+  offsetSet(key: object | null, value: unknown): void {
+    if (key === null) {
+      throw new PhpError("Cannot append to WeakMap");
+    }
+    const object = objectKey(key);
+    const normal = value ?? null;
+    const entry = this.#byKey.get(object);
+    if (entry !== undefined) {
+      entry.value = normal;
+      return;
+    }
+    const created: Entry = { ref: new WeakRef(object), value: normal };
+    this.#byKey.set(object, created);
+    this.#order.add(created);
+    this.#registry.register(object, created, created);
+  }
+
+  /** `isset($map[$key])`: false for a missing key and for a null value. */
+  offsetExists(key: object): boolean {
+    const entry = this.#byKey.get(objectKey(key));
+    return entry !== undefined && entry.value !== null;
+  }
+
+  /** `unset($map[$key])`. */
+  offsetUnset(key: object): void {
+    const object = objectKey(key);
+    const entry = this.#byKey.get(object);
+    if (entry !== undefined) {
+      this.#byKey.delete(object);
+      this.#order.delete(entry);
+      this.#registry.unregister(entry);
+    }
+  }
+
+  /** `count($map)`: the entries whose key is alive. */
+  count(): number {
+    let count = 0;
+    for (const entry of this.#order) {
+      if (entry.ref.deref() !== undefined) {
+        count++;
+      }
+    }
+    return count;
+  }
+
+  /** An `InternalIterator` over the live entries, keys the objects. */
+  getIterator(): InternalIterator {
+    const order = this.#order;
+    return internalIterator<Entry>({
+      cursor: new LiveCursor<Entry>(
+        () => order.values(),
+        (entry) => order.has(entry) && entry.ref.deref() !== undefined,
+      ),
+      key: (entry) => entry.ref.deref() ?? null,
+      current: (entry) => entry.value,
+    });
+  }
+
+  /** PHP refuses to serialize a WeakMap. */
+  __serialize(): never {
+    throw new Exception("Serialization of 'WeakMap' is not allowed");
+  }
+
+  /** PHP refuses to unserialize a WeakMap. */
+  __unserialize(_data: unknown): never {
+    throw new Exception("Unserialization of 'WeakMap' is not allowed");
+  }
+
+  [Symbol.iterator](): Generator<[unknown, unknown], void, undefined> {
+    return this.getIterator()[Symbol.iterator]();
+  }
+}
+
+registerClass("WeakMap", WeakMap);
