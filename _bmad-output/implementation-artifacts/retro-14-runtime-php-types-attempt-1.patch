--- /dev/null
+++ b/packages/runtime/src/php/arrayStorage.ts
@@ -0,0 +1,86 @@
+// The storage `ArrayObject` and `ArrayIterator` share (ESC-14.1-2). Internal. Each instance's state (its storage box,
+// flags and, for an `ArrayIterator`, its position) lives in a side table keyed by the instance, so an instance
+// `phpUnserialize` builds without the constructor gets an empty state on first use and `__unserialize` fills it. The
+// box is shared: an `ArrayObject`'s `getIterator()`, and an `ArrayObject` or `ArrayIterator` built over another one,
+// read and write the same `PhpArray`, as PHP's do; `exchangeArray` replaces the array inside the box, so the
+// iterators see the new one.
+import { arrayEntries } from "./casts";
+import { LiveCursor } from "./liveCursor";
+import { objectProps } from "./mangle";
+import { PhpArray, type PhpArrayKey, type PhpKeyInput } from "./PhpArray";
+import { phpType, phpTypeName } from "./phpType";
+import { TypeError as PhpTypeError } from "./TypeError";
+
+/** The array an `ArrayObject` and its iterators share. */
+export interface ArrayBox {
+  array: PhpArray<PhpKeyInput, unknown>;
+}
+
+/** One instance's state. */
+export interface ArrayState {
+  box: ArrayBox;
+  flags: number;
+  /** The position of an `ArrayIterator`, made on first use. */
+  cursor: LiveCursor<PhpArrayKey> | null;
+}
+
+const states = new WeakMap<object, ArrayState>();
+
+/** The state of `o`, an empty one when it has none (an instance built without its constructor). */
+export function stateOf(o: object): ArrayState {
+  let state = states.get(o);
+  if (state === undefined) {
+    state = { box: { array: new PhpArray() }, flags: 0, cursor: null };
+    states.set(o, state);
+  }
+  return state;
+}
+
+/**
+ * The box for the constructor argument `value` of `<className>::__construct()`: a copy of a PHP array, the box of an
+ * `ArrayObject` or `ArrayIterator` (shared), or a copy of any other object's properties. Throws PHP's `TypeError` for
+ * any other value.
+ */
+export function boxFor(className: string, value: unknown): ArrayBox {
+  const type = typeof value === "symbol" || typeof value === "bigint" ? "int" : phpType(value);
+  if (type === "array") {
+    return { array: value instanceof PhpArray ? (value.copy() as PhpArray<PhpKeyInput, unknown>) : new PhpArray(arrayEntries(value as object)) };
+  }
+  if (type === "object") {
+    const shared = states.get(value as object);
+    return shared !== undefined ? shared.box : { array: new PhpArray(objectProps(value as object)) };
+  }
+  throw new PhpTypeError(`${className}::__construct(): Argument #1 ($array) must be of type array, ${phpTypeName(value)} given`);
+}
+
+/** Sets up `o`'s state from its constructor arguments. */
+export function initState(o: object, className: string, array: unknown, flags: number): void {
+  states.set(o, { box: boxFor(className, array), flags, cursor: null });
+}
+
+/** `__serialize()`'s array: flags, a copy of the storage, the dynamic properties and the iterator class (null). */
+export function serializeState(o: object): unknown[] {
+  const state = stateOf(o);
+  const members: Record<string, unknown> = {};
+  for (const key of Object.keys(o)) {
+    Object.defineProperty(members, key, { value: (o as Record<string, unknown>)[key] ?? null, enumerable: true, writable: true, configurable: true });
+  }
+  return [state.flags, state.box.array.copy(), members, null];
+}
+
+/** `__unserialize($data)`: restores what `serializeState` wrote. */
+export function unserializeState(o: object, data: unknown): void {
+  const entries = new Map(phpType(data) === "array" ? arrayEntries(data as object) : []);
+  const state = stateOf(o);
+  const flags = entries.get(0);
+  state.flags = typeof flags === "number" ? flags : 0;
+  const storage = entries.get(1);
+  state.box = { array: phpType(storage) === "array" ? new PhpArray(arrayEntries(storage as object)) : new PhpArray() };
+  state.cursor = null;
+  const members = entries.get(2);
+  if (phpType(members) === "array") {
+    for (const [key, value] of arrayEntries(members as object)) {
+      Object.defineProperty(o, String(key), { value, enumerable: true, writable: true, configurable: true });
+    }
+  }
+}
