+import { phpInterface } from "./phpInterface";
+import { Traversable } from "./Traversable";
+
+declare const IteratorBrand: unique symbol;
+
+/** PHP's `Iterator`. */
+export interface Iterator extends Traversable {
+  readonly [Iterator.brand]: true;
+  current(): unknown;
+  key(): unknown;
+  next(): void;
+  rewind(): void;
+  valid(): boolean;
+}
