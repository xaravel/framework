{
  "name": "@xaravel/support",
  "version": "0.0.0",
  "description": "Xaravel's port of Laravel's illuminate/support component.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xaravel/framework.git",
    "directory": "packages/support"
  },
  "type": "module",
