{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "composite": true,
    "noEmit": false,
    "emitDeclarationOnly": true,
    "rootDir": ".",
    "outDir": "../../.cache/tsc/config",
    "tsBuildInfoFile": "../../.cache/tsc/config/tsconfig.tsbuildinfo",
    "types": [
      "bun"
    ]
  },
  "include": [
    "src/**/*.ts",
    "tests/**/*.ts"
  ],
  "references": [
    {
      "path": "../collections"
    },
    {
      "path": "../contracts"
    },
    {
      "path": "../runtime"
    }
  ]
}
