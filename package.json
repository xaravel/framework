{
  "name": "xaravel",
  "version": "0.0.0",
  "private": true,
  "description": "A TypeScript port of Laravel for Bun, built for htmx 4.",
  "license": "MIT",
  "type": "module",
  "workspaces": [
    "packages/*",
    "skeleton",
    "installer",
    "tools/*"
  ],
  "engines": {
    "bun": ">=1.4"
  },
  "scripts": {
    "test": "bun test",
    "typecheck": "bun --bun tsc -b",
    "lint": "bun --bun oxlint --type-aware",
    "scaffold": "bun tools/scaffold/scaffold.ts",
    "scaffold:check": "bun tools/scaffold/scaffold.ts --check",
    "scaffold:table": "bun tools/scaffold/table.ts",
    "graph:check": "bun tools/graph/graph.ts",
    "protected-paths:codeowners": "bun tools/protected-paths/protected-paths.ts codeowners",
    "ownership:check": "bun tools/ownership/ownership.ts manifests"
  },
  "devDependencies": {
    "@types/bun": "1.4.3",
    "oxlint": "1.88.0",
    "oxlint-tsgolint": "7.0.2004",
    "typescript": "7.0.2"
  }
}
