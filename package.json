{
  "name": "xaravel",
  "version": "0.0.0",
  "private": true,
  "description": "A TypeScript port of Laravel for Bun, built for htmx 4.",
  "license": "MIT",
  "type": "module",
  "workspaces": [
    "packages/*",
    "skeleton",
    "installer",
    "tools/*"
  ],
  "engines": {
    "bun": ">=1.4"
  },
  "scripts": {
    "test": "bun test",
    "typecheck": "bun --bun tsc -b",
    "lint": "bun --bun oxlint --type-aware",
    "scaffold": "bun tools/scaffold/scaffold.ts",
    "scaffold:check": "bun tools/scaffold/scaffold.ts --check",
    "scaffold:table": "bun tools/scaffold/table.ts",
    "graph:check": "bun tools/graph/graph.ts",
    "protected-paths:codeowners": "bun tools/protected-paths/protected-paths.ts codeowners",
    "ownership:check": "bun tools/ownership/ownership.ts manifests",
    "escalations:check": "bun tools/escalations/escalations.ts check",
    "ruleset:verify": "bun tools/ruleset/ruleset.ts verify",
    "ruleset:apply": "bun tools/ruleset/ruleset.ts apply",
    "ruleset:identity": "bun tools/ruleset/ruleset.ts identity",
    "workflows:check": "bun tools/workflow-permissions/workflow-permissions.ts check",
    "release:stamp": "bun tools/release/release.ts stamp",
    "release:check": "bun tools/release/release.ts check",
    "release:authority": "bun tools/release/release.ts authority",
    "upstream:sync": "bun tools/upstream/upstream.ts sync",
    "upstream:check": "bun tools/upstream/upstream.ts check",
    "oracle:check": "bun tools/oracle/oracle.ts check",
    "oracle:tag": "bun tools/oracle/oracle.ts tag",
    "oracle:lock": "bun tools/oracle/oracle.ts lock",
    "oracle:verify-image": "bun tools/oracle/oracle.ts verify-image",
    "oracle:build": "bun tools/oracle/oracle.ts build",
    "oracle:extract": "bun tools/oracle/extract.ts",
    "oracle:fixtures": "bun tools/oracle/fixtures.ts",
    "oracle:verify-fixtures": "bun tools/oracle/verify.ts",
    "oracle:story": "bun tools/oracle/story.ts",
    "oracle:api-surface": "bun tools/oracle/api-surface.ts",
    "scan:facades": "bun tools/scans/facades.ts",
    "scan:singletons": "bun tools/scans/singletons.ts",
    "scan:closures": "bun tools/scans/closures.ts",
    "scan:div12": "bun tools/scans/div12.ts",
    "scan:test-api": "bun tools/scans/test-api.ts",
    "assert:coverage": "bun tools/assert-coverage/coverage.ts",
    "mockery:coverage": "bun tools/mockery-coverage/coverage.ts",
    "component-map:check": "bun tools/component-map/component-map.ts check",
    "inventory": "bun tools/inventory/inventory.ts generate",
    "inventory:cross-check": "bun tools/inventory/cross-check.ts",
    "baseline": "bun tools/baseline/baseline.ts",
    "pin:bump": "bun tools/pin-bump/pin-bump.ts",
    "expectations:init": "bun tools/expectations/expectations.ts init",
    "expectations:check": "bun tools/expectations/expectations.ts check",
    "expectations:reasons": "bun tools/expectations/reasons.ts check",
    "harness": "bun --no-env-file conformance/harness/harness.ts",
    "php-fixtures:install": "composer install --no-interaction --no-progress --no-plugins --no-scripts --working-dir=conformance/tests/xaravel/php-fixtures/phpunit && composer install --no-interaction --no-progress --no-plugins --no-scripts --working-dir=conformance/tests/xaravel/php-fixtures/pest"
  },
  "devDependencies": {
    "@types/bun": "1.4.3",
    "oxlint": "1.88.0",
    "oxlint-tsgolint": "7.0.2004",
    "typescript": "7.0.2"
  }
}
