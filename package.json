{
  "name": "xaravel",
  "version": "0.0.0",
  "private": true,
  "description": "A TypeScript port of Laravel for Bun, built for htmx 4.",
  "license": "MIT",
  "type": "module",
  "workspaces": [
    "packages/*",
    "skeleton",
    "installer",
    "tools/*"
  ],
  "engines": {
    "bun": ">=1.4"
  },
  "scripts": {
    "test": "bun test",
    "typecheck": "bun --bun tsc -p tsconfig.json",
    "lint": "bun --bun oxlint --type-aware"
  },
  "devDependencies": {
    "@types/bun": "1.4.3",
    "oxlint": "1.88.0",
    "oxlint-tsgolint": "7.0.2004",
    "typescript": "7.0.2"
  }
}
