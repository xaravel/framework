{
  "name": "xaravel",
  "version": "0.0.0",
  "private": true,
  "description": "A TypeScript port of Laravel for Bun, built for htmx 4.",
  "license": "MIT",
  "type": "module",
  "workspaces": [
    "packages/*",
    "skeleton",
    "installer",
    "tools/*"
  ],
  "engines": {
    "bun": ">=1.4"
  },
  "scripts": {
    "test": "bun --no-env-file test",
    "typecheck": "bun --no-env-file --bun tsc -b",
    "lint": "bun --no-env-file --bun oxlint --type-aware && bun --no-env-file run lint:disables",
    "lint:disables": "bun --no-env-file tools/lint-rules/disables.ts",
    "async-surface": "bun --no-env-file tools/async-surface/async-surface.ts",
    "api-surface": "bun --no-env-file tools/api-surface/api-surface.ts",
    "api-surface:gate": "bun --no-env-file tools/api-surface/api-surface.ts --gate",
    "scaffold": "bun --no-env-file tools/scaffold/scaffold.ts",
    "scaffold:check": "bun --no-env-file tools/scaffold/scaffold.ts --check",
    "registration:check": "bun --no-env-file tools/registration/registration.ts",
    "conformance:report": "bun --no-env-file tools/conformance-report/report.ts",
    "conformance:history": "bun --no-env-file tools/conformance-report/history.ts",
    "conformance:site": "bun --no-env-file tools/conformance-report/site.ts",
    "conformance:publish": "bun --no-env-file tools/conformance-report/publish.ts",
    "conformance:target": "bun --no-env-file tools/conformance-report/target.ts",
    "scaffold:table": "bun --no-env-file tools/scaffold/table.ts",
    "graph:check": "bun --no-env-file tools/graph/graph.ts",
    "protected-paths:codeowners": "bun --no-env-file tools/protected-paths/protected-paths.ts codeowners",
    "ownership:check": "bun --no-env-file tools/ownership/ownership.ts manifests",
    "escalations:check": "bun --no-env-file tools/escalations/escalations.ts check",
    "ruleset:verify": "bun --no-env-file tools/ruleset/ruleset.ts verify",
    "ruleset:apply": "bun --no-env-file tools/ruleset/ruleset.ts apply",
    "ruleset:identity": "bun --no-env-file tools/ruleset/ruleset.ts identity",
    "workflows:check": "bun --no-env-file tools/workflow-permissions/workflow-permissions.ts check",
    "entry-scripts:check": "bun --no-env-file tools/entry-scripts/entry-scripts.ts check",
    "release:stamp": "bun --no-env-file tools/release/release.ts stamp",
    "release:check": "bun --no-env-file tools/release/release.ts check",
    "release:authority": "bun --no-env-file tools/release/release.ts authority",
    "upstream:sync": "bun --no-env-file tools/upstream/upstream.ts sync",
    "upstream:check": "bun --no-env-file tools/upstream/upstream.ts check",
    "oracle:check": "bun --no-env-file tools/oracle/oracle.ts check",
    "oracle:tag": "bun --no-env-file tools/oracle/oracle.ts tag",
    "oracle:lock": "bun --no-env-file tools/oracle/oracle.ts lock",
    "oracle:verify-image": "bun --no-env-file tools/oracle/oracle.ts verify-image",
    "oracle:build": "bun --no-env-file tools/oracle/oracle.ts build",
    "oracle:extract": "bun --no-env-file tools/oracle/extract.ts",
    "oracle:fixtures": "bun --no-env-file tools/oracle/fixtures.ts",
    "oracle:verify-fixtures": "bun --no-env-file tools/oracle/verify.ts",
    "oracle:story": "bun --no-env-file tools/oracle/story.ts",
    "oracle:recheck": "bun --no-env-file tools/oracle/recheck.ts",
    "oracle:api-surface": "bun --no-env-file tools/oracle/api-surface.ts",
    "scan:facades": "bun --no-env-file tools/scans/facades.ts",
    "scan:singletons": "bun --no-env-file tools/scans/singletons.ts",
    "scan:closures": "bun --no-env-file tools/scans/closures.ts",
    "scan:div12": "bun --no-env-file tools/scans/div12.ts",
    "scan:test-api": "bun --no-env-file tools/scans/test-api.ts",
    "scan:builtins": "bun --no-env-file tools/scans/builtins.ts",
    "assert:coverage": "bun --no-env-file tools/assert-coverage/coverage.ts",
    "mockery:coverage": "bun --no-env-file tools/mockery-coverage/coverage.ts",
    "component-map:check": "bun --no-env-file tools/component-map/component-map.ts check",
    "inventory": "bun --no-env-file tools/inventory/inventory.ts generate",
    "inventory:cross-check": "bun --no-env-file tools/inventory/cross-check.ts",
    "baseline": "bun --no-env-file tools/baseline/baseline.ts",
    "pin:bump": "bun --no-env-file tools/pin-bump/pin-bump.ts",
    "expectations:init": "bun --no-env-file tools/expectations/expectations.ts init",
    "expectations:check": "bun --no-env-file tools/expectations/expectations.ts check",
    "expectations:reasons": "bun --no-env-file tools/expectations/reasons.ts check",
    "divergence:check": "bun --no-env-file tools/divergence/divergence.ts check",
    "porting:check": "bun --no-env-file tools/porting/porting.ts check",
    "porting:generate": "bun --no-env-file tools/porting/porting.ts generate",
    "porting:translate": "bun --no-env-file tools/porting/translate.ts translate",
    "probes:run": "bun --no-env-file conformance/probes/probes.ts run",
    "probes:check": "bun --no-env-file conformance/probes/probes.ts check",
    "probes:record": "bun --no-env-file conformance/probes/probes.ts record",
    "probes:generate": "bun --no-env-file conformance/probes/probes.ts generate",
    "spikes:requests": "bun --no-env-file conformance/spikes/spikes.ts requests",
    "spikes:check": "bun --no-env-file conformance/spikes/spikes.ts check",
    "spikes:generate": "bun --no-env-file conformance/spikes/spikes.ts generate",
    "harness": "bun --no-env-file conformance/harness/harness.ts",
    "ratchet": "bun --no-env-file tools/ratchet/ratchet.ts",
    "xt:consequences": "bun --no-env-file tools/xt-coverage/consequences.ts",
    "xt:coverage": "bun --no-env-file tools/xt-coverage/coverage.ts",
    "fidelity:review": "bun --no-env-file tools/fidelity-review/fidelity-review.ts",
    "story:check": "bun --no-env-file tools/story-check/story-check.ts",
    "devcontainer:pins": "bun --no-env-file tools/devcontainer/pins.ts check",
    "devcontainer:alpha": "bun --no-env-file tools/devcontainer/alpha.ts",
    "bots": "bun --no-env-file tools/bots/bots.ts",
    "bench": "bun --no-env-file tools/bench/bench.ts",
    "php-fixtures:install": "composer install --no-interaction --no-progress --no-plugins --no-scripts --working-dir=conformance/tests/xaravel/php-fixtures/phpunit && composer install --no-interaction --no-progress --no-plugins --no-scripts --working-dir=conformance/tests/xaravel/php-fixtures/pest"
  },
  "devDependencies": {
    "@types/bun": "1.4.3",
    "oxc-parser": "0.155.0",
    "oxlint": "1.88.0",
    "oxlint-tsgolint": "7.0.2004",
    "typescript": "7.0.2"
  }
}
