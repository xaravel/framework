{
  "name": "xaravel",
  "version": "0.0.0",
  "private": true,
  "description": "A TypeScript port of Laravel for Bun, built for htmx 4.",
  "license": "MIT",
  "type": "module",
  "workspaces": [
    "packages/*",
    "skeleton",
    "installer",
    "tools/*"
  ],
  "engines": {
    "bun": ">=1.4"
  },
  "scripts": {
    "test": "bun test",
    "typecheck": "bun --bun tsc -b",
    "lint": "bun --bun oxlint --type-aware",
    "scaffold": "bun tools/scaffold/scaffold.ts",
    "scaffold:check": "bun tools/scaffold/scaffold.ts --check",
    "scaffold:table": "bun tools/scaffold/table.ts",
    "graph:check": "bun tools/graph/graph.ts",
    "protected-paths:codeowners": "bun tools/protected-paths/protected-paths.ts codeowners",
    "ownership:check": "bun tools/ownership/ownership.ts manifests",
    "escalations:check": "bun tools/escalations/escalations.ts check",
    "ruleset:verify": "bun tools/ruleset/ruleset.ts verify",
    "ruleset:apply": "bun tools/ruleset/ruleset.ts apply",
    "ruleset:identity": "bun tools/ruleset/ruleset.ts identity",
    "workflows:check": "bun tools/workflow-permissions/workflow-permissions.ts check",
    "release:stamp": "bun tools/release/release.ts stamp",
    "release:check": "bun tools/release/release.ts check",
    "release:authority": "bun tools/release/release.ts authority",
    "upstream:sync": "bun tools/upstream/upstream.ts sync",
    "upstream:check": "bun tools/upstream/upstream.ts check"
  },
  "devDependencies": {
    "@types/bun": "1.4.3",
    "oxlint": "1.88.0",
    "oxlint-tsgolint": "7.0.2004",
    "typescript": "7.0.2"
  }
}
