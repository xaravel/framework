{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "jsPlugins": ["./tools/lint-rules/plugin.ts"],
  "categories": {
    "correctness": "error"
  },
  "rules": {
    "typescript/no-floating-promises": ["error", { "checkThenables": true }],
    "typescript/await-thenable": "error",
    "typescript/no-misused-promises": ["error", { "checksVoidReturn": true, "checksConditionals": true }],
    "unicorn/no-thenable": "off",
    "xaravel/no-identity-constructor-name": "error",
    "xaravel/no-framework-json-stringify": "error",
    "xaravel/no-ported-bun-expect": "error",
    "xaravel/no-type-import-injection": "error",
    "xaravel/no-model-private": "error",
    "xaravel/no-package-default-export": "error",
    "xaravel/no-maybe-promise-return": "error",
    "xaravel/no-async-thenable-return": "error",
    "xaravel/no-singleton-field-write": "error",
    "xaravel/no-boot-only-write": "error",
    "xaravel/no-arrow-test-body": "error",
    "xaravel/no-inject-param-mismatch": "error",
    "xaravel/no-dynamic-column-default": "error"
  },
  "ignorePatterns": [
    "_bmad/**",
    "_bmad-output/**",
    "conformance/upstream/**",
    ".claude/**",
    "node_modules/**",
    "tools/lint-rules/fixtures/**"
  ],
  "overrides": [
    {
      "files": ["packages/**"],
      "rules": {
        "typescript/return-await": ["error", "always"]
      }
    }
  ]
}
